Module
  name: game_interface
  description: Create the game interface, where the ingame stuff starts
  author: OTClient team
  website: https://github.com/edubart/otclient
  sandboxed: true
  scripts: [ widgets/uigamemap, gameinterface ]
  load-later:
    - game_hotkeys
    - game_textmessage
    - game_console
    - game_outfit
    - game_minimap
    - game_healthinfo
    - game_inventory
    - game_sidemenu
    - game_skills
    - game_battle
    - game_viplist
    - game_containers
    - game_npctrade
    - game_textwindow
    - game_playertrade
    - game_bugreport
    - game_playerdeath
    - game_playermount
    - game_ruleviolation
    - game_market
    - game_spelllist
    - game_cooldown
    - game_modaldialog
    - game_unjustifiedpoints
    - game_walking
    - game_shop
    - game_itemselector
    - client_textedit
    - client_cam
    - client_profiles
    - game_imbuing
    - game_stats
    - game_shaders
    - game_shadersmap
    - game_analyserexp
    - game_analyserloot
    - game_whiteredskull
    - game_modal
    - game_bestiary
    - game_battlepass
    - game_dummy
  @onLoad: init()
  @onUnload: terminate()
