        color: #c0c0c0
        margin-left: 6
        width: 120

      UIWidget
        size: 10 10
        image-source: /images/game/prey/prey_gold
        image-size: 10 10
        margin-right: 4

    Panel
      width: 90
      height: 20
      image-source: /modules/game_forge/images/cardBg
      image-size: 52 20
      layout: horizontalBox
      spacing: 2

      Label
        id: dustCount
        text: 0/100
        font: verdana-9px
        color: #c0c0c0
        margin-left: 4
        width: 68

      UIWidget
        size: 9 6
        image-source: /modules/game_forge/images/icon-currency-dust
        image-size: 9 6
        margin-right: 4

    Panel
      width: 55
      height: 20
      image-source: /modules/game_forge/images/cardBg
      image-size: 52 20
      layout: horizontalBox
      spacing: 2

      Label
        id: sliversCount
        text: 0
        font: verdana-9px
        color: #c0c0c0
        margin-left: 4
        width: 36

      UIWidget
        size: 9 9
        image-source: /modules/game_forge/images/icon-currency-sliver
        image-size: 9 9
        margin-right: 4

    Panel
      width: 55
      height: 20
      image-source: /modules/game_forge/images/cardBg
      image-size: 52 20
      layout: horizontalBox
      spacing: 2

      Label
        id: coresCount
        text: 0
        font: verdana-9px
        color: #c0c0c0
        margin-left: 4
        width: 36

      UIWidget
        size: 9 9
        image-source: /modules/game_forge/images/icon-currency-exaltedcore
        image-size: 9 9

    Label
      id: errorLabel
      font: verdana-9px
      color: #d33c3c
      visible: false

    Button
      text: Close
      width: 60
      @onClick: modules.game_forge.hide()
