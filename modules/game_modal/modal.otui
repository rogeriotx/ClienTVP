MainWindow
  id: ModalUI
  !text: tr('???')
  width: 400
  anchors.centerIn: parent

  Label
    id: text
    !text: tr('???')
    text-wrap: true
    text-auto-resize: true
    font: verdana-11px-rounded
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right

  HorizontalSeparator
    anchors.top: text.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10

  Button
    !text: tr('Accept')
    size: 64 22
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-right: 40
    @onClick: modules.game_modal.Modal.Accept()

  Button
    !text: tr('Cancel')
    size: 64 22
    anchors.left: prev.right
    margin-left: 25
    anchors.bottom: parent.bottom
    @onClick: modules.game_modal.Modal.Cancel()