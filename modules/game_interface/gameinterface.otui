GameSidePanel < UIMiniWindowContainer
  image-source: /images/ui/panel_side2
  image-border: 4
  padding: 0
  width: 176
  focusable: false
  on: true
  layout:
    type: verticalBox
  $mobile:
    padding: 0
    width: 200

GameMapPanel < UIGameMap
  padding: 4
  image-source: /images/ui/panel_flat
  image-border: 1
  image-color: alpha

  $on:
    padding: 0
    
GameAction < UIButton
  size: 64 64
  phantom: false
    
  UIButton
    id: image
    size: 48 48
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    phantom: true
    $checked:
      opacity: 1.0
      background: #00FF0033
    $!checked:
      opacity: 0.6
      background: alpha

UIWidget
  id: gameRootPanel
  anchors.fill: parent
  image-source: /images/ui/panel_side
  image-border: 4
  image-clip: 2 2 92 93 
  padding: 0
  
  GameMapPanel
    id: gameMapPanel
    anchors.left: gameLeftPanels.right
    anchors.right: gameRightPanels.left
    anchors.top: parent.top
    anchors.bottom: gameBottomPanel.top
    focusable: false
    
  Panel
    id: gameLeftActions
    focusable: false
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    width: 64
    
    $!mobile:
      visible: false
      width: 0
    
    layout:
      type: verticalBox
      fit-children: true
      
    GameAction
      id: use
      @onSetup: self.image:setImageSource("/images/game/mobile/use")
    GameAction
      id: attack
      @onSetup: self.image:setImageSource("/images/game/mobile/attack")
    GameAction
      id: follow
      @onSetup: self.image:setImageSource("/images/game/mobile/follow")
    GameAction
      id: look
      @onSetup: self.image:setImageSource("/images/game/mobile/look")
    GameAction
      id: chat
      @onSetup: self.image:setImageSource("/images/game/mobile/chat")

  UIWidget
    id: gameTopLeftPanelBackground
    anchors.top: parent.top
    anchors.left: parent.left
    padding: 0
    margin: 0
    margin-top: 2
    focusable: false

    GameSidePanel
      id: gameTopLeftPanel
      &topPanel: true
      anchors.fill: parent
    
    ResizeBorder
      id: bottomResizeBorder
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right

  Panel
    id: gameLeftPanels
    focusable: false
    anchors.top: prev.bottom
    anchors.bottom: parent.bottom
    margin-top: 0
    $!mobile:
      anchors.left: parent.left
    $mobile:
      anchors.left: gameLeftActions.right

    layout:
      type: horizontalBox
      fit-children: true

  UIButton
    id: frontLeft
    size: 9 27
    anchors.bottom: next.top
    anchors.left: next.left
    image-source: /images/ui/left
    margin: 1 0 0 0
    @onClick: modules.game_interface.openPanelLeft(self)
    !tooltip: tr("Open one left panel")

    $!pressed:
      image-clip: 0 0 9 27

    $pressed:
      image-clip: 9 0 9 27

  UIButton
    id: backLeft
    size: 9 27
    anchors.top: parent.top
    anchors.left: gameLeftPanels.right
    image-source: /images/ui/left
    margin: 27 0 0 -1
    @onClick: modules.game_interface.openPanelLeft(self)
    !tooltip: tr("Close one left panel")

    $!on:
      image-clip: 0 27 9 27
      margin: 27 0 0 1
    
    $on !pressed:
      image-clip: 18 27 9 27
      margin: 27 0 0 -1
    
    $on pressed:
      image-clip: 27 27 9 27
      margin: 27 0 0 -1

  Panel
    id: gameLeftActionPanel
    phantom: true
    focusable: false
    anchors.top: gameTopBar.bottom
    anchors.left: gameLeftPanels.right
    anchors.bottom: bottomSplitter.top
    margin-top: 3

    $mobile:
      visible: false
      
    layout:
      type: horizontalBox
      fit-children: true

  UIWidget
    id: gameTopRightPanelBackground
    anchors.top: parent.top
    anchors.right: parent.right
    padding: 0
    margin: 0
    margin-top: 2
    focusable: false

    GameSidePanel
      id: gameTopRightPanel
      &topPanel: true
      anchors.fill: parent
    
    ResizeBorder
      id: bottomResizeBorder
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right

  Panel
    id: gameRightPanels
    anchors.right: parent.right
    anchors.top: prev.bottom
    anchors.bottom: parent.bottom
    margin-top: 0
    focusable: false
    layout:
      type: horizontalBox
      fit-children: true      

  UIButton
    id: frontRight
    size: 9 27
    anchors.top: parent.top
    anchors.right: prev.left
    image-source: /images/ui/right
    margin: 1 -1 0 0
    @onClick: modules.game_interface.openPanelRight(self)
    !tooltip: tr("Open one right panel")

    $!pressed:
      image-clip: 0 0 9 27

    $pressed:
      image-clip: 9 0 9 27

  UIButton
    id: backRight
    size: 9 27
    anchors.top: prev.bottom
    anchors.right: prev.right
    image-source: /images/ui/right
    margin: 0 0 0 0
    @onClick: modules.game_interface.openPanelRight(self)
    !tooltip: tr("Close one right panel")

    $!on:
      image-clip: 0 27 9 27
    
    $on !pressed:
      image-clip: 18 27 9 27
    
    $on pressed:
      image-clip: 27 27 9 27
    
  Panel
    id: gameBottomPanel
    anchors.left: bottomSplitter.left
    anchors.right: bottomSplitter.right
    anchors.top: bottomSplitter.top
    anchors.bottom: parent.bottom

  Splitter
    id: bottomSplitter
    anchors.left: gameLeftPanels.right
    anchors.right: gameRightPanels.left
    anchors.bottom: parent.bottom
    height: 5
    relative-margin: bottom
    margin-bottom: 108
    @canUpdateMargin: function(self, newMargin) if modules.client_options.getOption('dontStretchShrink') then return self:getMarginBottom() end return math.max(math.min(newMargin, self:getParent():getHeight() - 100), 108) end
    @onGeometryChange: function(self) self:setMarginBottom(math.min(math.max(self:getParent():getHeight() - 190, 80), self:getMarginBottom())) end
    
    $mobile:
      visible: false
      
  UIWidget
    id: mouseGrabber
    focusable: false
    visible: false
  
  FlatPanel
    id: tooltipItem
    visible: false
    anchors.bottom: bottomSplitter.top
    anchors.right: gameRightPanels.left
    margin: 10
    image-source: /images/ui/menubox
    image-border: 3
    phantom: true
      
    UIItem
      id: itemSprite
      font: verdana-11px-rounded
      virtual: true
      anchors.top: parent.top
      anchors.left: parent.left
      size: 68 68
      margin-top: 5
      margin-left: 5
      padding: 2
      

    Panel
      id: labels
      anchors.fill: parent
      margin-top: 5
      margin-bottom: 5
      margin-left: 5
      margin-right: 5