OptionPanel
  size: 236 450
  text: Interface Options

  OptionCheckBoxBackground
    OptionCheckBox
      id: showPing
      !text: tr('Show Latency')
      !tooltip: tr('Display connection speed to the server (milliseconds)')

  OptionCheckBoxBackground
    OptionCheckBox
      id: displayNames
      !text: tr('Show Creature Names')

  OptionCheckBoxBackground
    OptionCheckBox
      id: displayHealth
      !text: tr('Show Creature Health Bars')
  
  OptionCheckBoxBackground
    OptionCheckBox
      id: showHealthManaCircle
      !text: tr('Show Health and Mana Circle')
      $mobile:
        visible: false
  
  OptionCheckBoxBackground
    OptionCheckBox
      id: displayMana
      !text: tr('Show Player Mana Bar')
      $mobile:
        visible: false
  
  OptionsLabel
    margin-left: 18
    margin-right: 18
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 12
    id: rarityBorderImage
    !text: tr("Choose Rarity Border Image:")

  ComboBoxRounded
    id: raritySelect
    anchors.left: prev.left
    anchors.right: prev.right
    anchors.top: prev.bottom
    margin-top: 3
    @onOptionChange: modules.client_options.setOption(self:getId(), self.currentIndex, false, true)
    @onSetup: |
      self:addOption("Minimal")
      self:addOption("Normal")
      self:addOption("Full")

  OptionsLabel
    !text: tr('Left Panels Amount:')

  UIButton
    id: backLeft
    size: 12 12
    image-source: /images/ui/miniwindow_buttons
    image-clip: 0 0 12 12
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 43
    @onClick: modules.game_interface.openPanelLeft(self)
    opacity: 1.0

    $disabled:
      opacity: 0.5

    $pressed:
      image-clip: 0 24 12 12


  Label
    id: leftCount
    !text: tr('0')
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 5

  UIButton
    id: frontLeft
    size: 12 12
    image-source: /images/ui/miniwindow_buttons
    image-clip: 12 12 12 12
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 6
    @onClick: modules.game_interface.openPanelLeft(self)
    opacity: 1.0

    $pressed:
      image-clip: 12 24 12 12

    $disabled:
      opacity: 0.5
  
  UIWidget
    text-offset: 0 0
    image-source: /images/ui/button
    image-border: 3
    image-clip: 0 46 22 23
    text-offset: 1 1
    height: 22
    margin-top: 10
    padding: 2 0 4 6
    image-smooth: true
    margin-left: 18
    margin-right: 18
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 12

    OptionCheckBox
      id: showTopLeftPanel
      !text: tr('Show Top Left Panel')
      opacity: 1.0

      $disabled:
        opacity: 0.5
      $mobile:
        visible: false 

  OptionsLabel
    !text: tr('Right Panels Amount:')
  
  UIButton
    id: backRight
    size: 12 12
    image-source: /images/ui/miniwindow_buttons
    image-clip: 0 0 12 12
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 37
    @onClick: modules.game_interface.openPanelRight(self)
    opacity: 1.0

    $pressed:
      image-clip: 0 24 12 12

    $disabled:
      opacity: 0.5

  Label
    id: rightCount
    !text: tr('0')
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 5

  UIButton
    id: frontRight
    size: 12 12
    image-source: /images/ui/miniwindow_buttons
    image-clip: 12 12 12 12
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 6
    @onClick: modules.game_interface.openPanelRight(self)
    opacity: 1.0

    $pressed:
      image-clip: 12 24 12 12

    $disabled:
      opacity: 0.5

  UIWidget
    text-offset: 0 0
    image-source: /images/ui/button
    image-border: 3
    image-clip: 0 46 22 23
    text-offset: 1 1
    height: 22
    padding: 2 0 4 6
    image-smooth: true
    margin-left: 18
    margin-right: 18
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 12

    OptionCheckBox
      id: showTopRightPanel
      !text: tr('Show Top Right Panel')
      opacity: 1.0

      $disabled:
        opacity: 0.5
      $mobile:
        visible: false 

  OptionsLabel
    width: 130
    margin-left: 18
    margin-right: 18
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 12
    id: backpackPanelLabel
    !text: tr("Container's Panel:")
    !tooltip: tr("Open New Containers in Selected Panel")
  
  ComboBoxRounded
    id: containerPanel
    anchors.left: backpackPanelLabel.left
    anchors.right: backpackPanelLabel.right
    anchors.top: backpackPanelLabel.bottom
    margin-top: 3
    @onOptionChange: modules.client_options.setOption(self:getId(), self.currentIndex, false, true)
    @onSetup: |
      self:addOption("1st Left Panel")
      self:addOption("2nd Left Panel")
      self:addOption("3rd Left Panel")
      self:addOption("4th Left Panel")
      self:addOption("Default Right Panel")
      self:addOption("2nd Right Panel")
      self:addOption("3rd Right Panel")
      self:addOption("4th Right Panel")
  
  padding: 0

  @onEnter: modules.client_options.okEdits(self)
  @onEscape: modules.client_options.cancelEdits(self)

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 9
    margin-left: 13
    margin-right: 13

  Button
    !text: tr('Ok')
    size: 43 20
    anchors.right: next.left
    anchors.bottom: next.bottom
    margin-right: 11
    @onClick: modules.client_options.okEdits(self:getParent())
  
  Button
    !text: tr('Cancel')
    size: 43 20
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 13
    margin-bottom: 10
    @onClick: modules.client_options.cancelEdits(self:getParent())
