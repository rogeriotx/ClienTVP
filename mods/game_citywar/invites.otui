CityWarInviteEntry < Panel
  height: 86
  padding: 4
  background-color: #00000022
  focusable: false

  $alternate:
    background-color: #00000044

  Label
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: acceptButton.left
    margin-right: 6
    font: verdana-11px-rounded
    color: #dfb382
    text-align: left

  Label
    id: details
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: acceptButton.left
    anchors.bottom: expires.top
    margin-top: 2
    margin-right: 6
    color: #dfdfdf
    text-wrap: true
    text-align: topLeft

  Label
    id: expires
    anchors.left: parent.left
    anchors.right: acceptButton.left
    anchors.bottom: parent.bottom
    height: 12
    font: verdana-9px
    color: #9f9f9f
    text-align: left

  Button
    id: acceptButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 6
    width: 80
    color: #2FA02F
    !text: tr('Accept')

  Button
    id: declineButton
    anchors.top: acceptButton.bottom
    anchors.right: parent.right
    margin-top: 6
    width: 80
    !text: tr('Decline')

Panel
  Label
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 28
    color: #dfdfdf
    text-wrap: true
    text-align: left
    !text: tr('War Private invites received by your guild. Only leaders can accept or decline. Invites expire in 2 minutes.')

  VerticalScrollBar
    id: listScroll
    anchors.top: header.bottom
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-top: 6
    step: 20
    pixels-scroll: true

  TextList
    id: list
    anchors.top: header.bottom
    anchors.left: parent.left
    anchors.right: listScroll.left
    anchors.bottom: parent.bottom
    margin-top: 6
    padding: 2
    vertical-scrollbar: listScroll

  Label
    id: emptyLabel
    anchors.centerIn: list
    color: #9f9f9f
    text-auto-resize: true
    !text: tr('No pending invites.')
