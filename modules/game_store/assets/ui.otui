StoreFlatPanelWidget < UIWidget
  phantom: true
  auto-focus: first
  image-source: panel
  image-border: 3

StoreLightFlatPanelWidget < UIWidget
  phantom: true
  auto-focus: first
  image-source: panel_container
  image-border: 3

StoreButtonWidget < Button
  $on !pressed:
    image-clip: 0 46 22 23
    text-offset: 1 1
  
  $!on !pressed:
    image-clip: 0 0 22 23
    image-border: 3

StoreWindowWidget < MainWindow
  size: 200 200
  padding-left: 18
  padding-right: 18
  padding-bottom: 13

  $disabled:
    color: #dfdfdf88

  $dragging:
    opacity: 0.8

StoreFlatLabelWidget < UILabel
  font: verdana-11px-rounded
  color: #dfdfdf
  size: 86 20
  text-offset: 3 3
  image-source: /images/ui/windowsolid
  image-border: 1

  $disabled:
    color: #dfdfdf88