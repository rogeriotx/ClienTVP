OptionCheckBoxBackground < UIWidget
  text-offset: 0 0
  image-source: /images/ui/button
  image-border: 3
  image-clip: 0 46 22 23
  text-offset: 1 1
  height: 22
  margin-top: 10
  padding: 2 0 4 6
  image-smooth: true
  @onClick: |
    local child = self:getChildByIndex(1)
    if child and not child:isDisabled() then
      modules.client_options.setOption(child:getId(), not child:isChecked(), false, true)
    end

  $first:
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 18
    margin-right: 18
    margin-top: 32
  
  $!first:
    anchors.left: prev.left
    anchors.right: prev.right
    anchors.top: prev.bottom
    margin-top: 12

OptionsLabel < Label
  anchors.top: prev.bottom
  margin-top: 10
  anchors.left: parent.left
  margin-left: 18
  color: #afafaf

OptionCheckBox < CheckBox
  @onCheckChange: modules.client_options.setOption(self:getId(), self:isChecked(), false, true)
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.verticalCenter: parent.verticalCenter
  margin: 2 0 0 0
  font: verdana-11px-antialised
  color: #afafaf

  $hover !disabled:
    color: #afafaf

OptionScrollbar < HorizontalScrollBar
  step: 1
  @onValueChange: modules.client_options.setOption(self:getId(), self:getValue(), false, true)
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: prev.bottom
  margin-top: 5
  margin-left: 18
  margin-right: 18
  color: #afafaf
  
OptionPanel < MainWindow
    
MainWindow
  id: optionsWindow
  !text: tr('Options')
  size: 286 327
  padding: 0
  color: #8f8f8f

  @onEnter: modules.client_options.hide()
  @onEscape: modules.client_options.hide()

  Button
    id: General
    text: General
    anchors.top: parent.top
    anchors.left:parent.left
    margin-top: 32
    margin-left: 18
    size: 86 20
  
  Button
    id: Graphics
    text: Graphics
    size: 86 20
    anchors.top: prev.bottom
    anchors.left: prev.left
    margin-top: 14
  
  Button
    id: Console
    text: Console
    size: 86 20
    anchors.top: prev.bottom
    anchors.left: prev.left
    margin-top: 14
  
  Button
    id: Interface
    text: Interface
    size: 86 20
    anchors.top: prev.bottom
    anchors.left: prev.left
    margin-top: 14

  Button
    id: Hotkeys
    text: Hotkeys
    size: 86 20
    anchors.top: prev.bottom
    anchors.left: prev.left
    margin-top: 14
    @onClick: modules.game_hotkeys.toggle() modules.client_options.hide()
  
  HorizontalSeparator
    id: separator2
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 14
    margin-left: 13
    margin-right: 13
  
  Button
    id: Motd
    text: Discord
    size: 86 20
    anchors.top: prev.bottom
    anchors.left: prev.left
    margin-top: 16
    margin-left: 5
    @onClick: g_platform.openUrl(discordInviteLink)
  
  Button
    id: OpenConfigs
    text: Game Data
    size: 86 20
    anchors.top: prev.bottom
    anchors.left: prev.left
    margin-top: 14
    @onClick: g_platform.openDir(g_resources.getWriteDir())  
  
  HorizontalSeparator
    id: separator2
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 21
    margin-left: 13
    margin-right: 13

  TabBarVertical
    id: optionsTabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    visible: false

  Panel
    id: optionsTabContent
    anchors.top: optionsTabBar.top
    anchors.left: optionsTabBar.right
    anchors.right: parent.right
    anchors.bottom: optionsTabBar.bottom
    margin-left: 10
    margin-top: 3
    visible: false

  Button
    !text: tr('Ok')
    size: 43 20
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 13
    margin-bottom: 10
    @onClick: |
      g_settings.save()
      modules.client_options.hide()
  
  Label
    text-vertical-auto-resize: true
    text: "Change general"
    text-align: bottomleft
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 117
    margin-top: 29
    color: #afafaf
  
  Label
    text-vertical-auto-resize: true
    text: "game options"
    text-align: bottomleft
    anchors.left: prev.left
    anchors.top: prev.bottom
    margin-top: 1
    color: #afafaf
  
  Label
    text-vertical-auto-resize: true
    text: "Change graphics and"
    text-align: bottomleft
    anchors.left: prev.left
    anchors.top: Graphics.top
    color: #afafaf
    margin-top: -3
  
  Label
    text-vertical-auto-resize: true
    text: "performance settings"
    text-align: bottomleft
    anchors.left: prev.left
    anchors.top: prev.bottom
    color: #afafaf
    margin-top: 1
  
  Label
    text-vertical-auto-resize: true
    text: "Customise the console"
    text-align: bottomleft
    anchors.left: prev.left
    anchors.top: Console.top
    color: #afafaf
    margin-top: -1
  
  Label
    text-vertical-auto-resize: true
    text: "Customise the interface"
    text-align: bottomleft
    anchors.left: prev.left
    anchors.top: Interface.top
    color: #afafaf
    margin-top: -1
  
  Label
    text-vertical-auto-resize: true
    text: "Edit your hotkey texts"
    text-align: bottomleft
    anchors.left: prev.left
    anchors.top: Hotkeys.top
    color: #afafaf
    margin-top: -1
  
  Label
    text-vertical-auto-resize: true
    text: "Join our Community on"
    text-align: bottomleft
    anchors.left: prev.left
    anchors.top: Motd.top
    color: #afafaf
    margin-top: -3
  Label
    text-vertical-auto-resize: true
    text: "Discord to keep updated"
    text-align: bottomleft
    anchors.left: prev.left
    anchors.top: prev.bottom
    color: #afafaf
    margin-top: 1
  
  Label
    text-vertical-auto-resize: true
    text: "Open \"Ravenor Online\""
    text-align: bottomleft
    anchors.left: prev.left
    anchors.top: OpenConfigs.top
    color: #afafaf
    margin-top: -3
  Label
    text-vertical-auto-resize: true
    text: "game data folder"
    text-align: bottomleft
    anchors.left: prev.left
    anchors.top: prev.bottom
    color: #afafaf
    margin-top: 1
  
