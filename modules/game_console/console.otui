Panel

  $first:
    anchors.fill: parent
    
  $!first:
    anchors.top: prev.bottom
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
  
  image-source: /images/ui/panel_side2
  image-border: 4
  margin-right: 1
  margin-left: 1
  auto-focus: last

  Panel
    id: consolePanel
    image-source: /images/ui/panel_bottom
    image-clip: 0 0 165 23
    image-border: 0
    image-border-top: 23
    auto-focus: last
    draggable: false
    phantom: true

    $first:
      anchors.fill: parent
      
    $!first:
      anchors.top: prev.bottom
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      
    TabButton
      id: prevChannelButton
      !tooltip: tr('Go to left channel')
      icon: /images/game/console/leftarrow
      anchors.right: next.left
      anchors.top: next.top
      margin-right: 1
      margin-top: 5
      size: 18 16
      
      $disabled:
        visible: false
      $!disabled:
        visible: true
    
    ConsoleTabBar
      id: consoleTabBar
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.right: next.left
      margin-left: 18
      margin-top: 0
      movable: true

    TabButton
      id: nextChannelButton
      !tooltip: tr('Go to right channel')
      icon: /images/game/console/rightarrow
      anchors.right: next.left
      anchors.top: parent.top
      margin-right: 1
      margin-top: 5
      size: 18 16
      $disabled:
        visible: false
      $!disabled:
        visible: true

    TabButton
      id: closeChannelButton
      !tooltip: tr('Close this channel') .. ' (Ctrl+E)'
      icon: /images/game/console/closechannel
      anchors.right: next.left
      anchors.top: parent.top
      enabled: false
      margin-right: 1
      margin-top: 5
      icon-clip: 0 0 16 16
      height: 16
      width: 16

      $pressed:
        icon-clip: 0 16 16 16

      @onClick: removeCurrentTab()

    TabButton
      id: channelsButton
      !tooltip: tr('Open new channel') .. ' (Ctrl+O)'
      icon: /images/game/console/channels
      anchors.right: next.left
      anchors.top: parent.top
      margin-right: 1
      margin-top: 5
      size: 16 16
      icon-clip: 0 0 16 16

      $pressed:
        icon-clip: 0 16 16 16

      @onClick: g_game.requestChannels()

    TabButton
      id: ignoreButton
      !tooltip: tr('Ignore players')
      icon: /images/game/console/ignore
      anchors.right: parent.right
      anchors.top: parent.top
      margin-right: 0
      margin-top: 5
      size: 16 16
      icon-clip: 0 0 16 16

      $pressed:
        icon-clip: 0 16 16 16

      @onClick: onClickIgnoreButton()

    Panel
      id: consoleContentPanel
      anchors.top: consoleTabBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 3
      margin-right: 2
      margin-bottom: 22
      margin-top: 3
      padding: 1
      focusable: false
      image-source: /images/ui/panel_bottom
      image-clip: 3 25 160 130
      image-border: 9
      image-border-bottom: 3

    TabButton
      id: sayModeButton
      icon: /images/game/console/say
      !tooltip: tr('Adjust volume')
      &sayMode: 2
      size: 16 16
      icon-clip: 0 0 16 16
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin-left: 5
      margin-bottom: 4
      @onClick: sayModeChange()

      $pressed:
        icon-clip: 0 16 16 16
    
    UICheckBox
      id: toggleChat
      !tooltip: tr('Disable chat mode, allow to walk using ASDW')
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      @onCheckChange: toggleChat()
      size: 64 16
      color: alpha
      icon-source: /images/topbuttons/chat
      change-cursor-image: true
      margin-right: 4
      margin-bottom: 4
      image-border: 3
      icon-rect: 0 0 16 15
      font: cipsoftFont
      color: white

      $!checked:
        image-source: /images/ui/button
        text: Chat on
        image-clip: 0 0 22 23
        text-offset: 18 5
        icon-clip: 0 0 16 15

      $checked:
        text: Chat off
        icon-clip: 0 16 16 15
        image-clip: 0 46 22 23
        text-offset: 19 6

      $disabled:
        opacity: 0.8
        change-cursor-image: false
    
    TextEdit
      id: consoleTextEdit
      anchors.left: sayModeButton.right
      anchors.right: prev.left
      anchors.verticalCenter: sayModeButton.verticalCenter
      margin-right: 4
      margin-left: 3
      shift-navigation: true
      max-length: 255
      height: 16
      on: true
      padding: 0 0 0 2
      focusable: false
      text-offset: 0 0
