            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 8
            margin-left: 10
            margin-right: 10
            height: 66
            image-source: /modules/game_forge/images/bigger-button
            image-size: 128 66
            image-clip: 0 0 128 66
            @onClick: modules.game_forge.doConvertDust()
            $pressed:
              image-clip: 0 66 128 66
            $disabled:
              opacity: 0.5

            UIItem
              item-id: 7635
              anchors.centerIn: parent
              size: 62 62
              virtual: true
              phantom: true

          Label
            anchors.top: prev.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 4
            text: Generate 3
            font: verdana-9px
            color: #c0c0c0
            text-align: center

      Panel
        width: 151
        height: 253

        Panel
          width: 151
          height: 18
          image-source: /modules/game_forge/images/conversion-column-header
          image-size: 151 18

          Label
            anchors.centerIn: parent
            text: Convert Slivers
            font: verdana-9px
            color: #c0c0c0

        Panel
          anchors.top: prev.bottom
          anchors.left: parent.left
          width: 151
          height: 235
          image-source: /modules/game_forge/images/conversion-column
          image-size: 151 235
          image-border: 2

          Panel
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 8
            size: 66 66
            image-source: /modules/game_forge/images/item66
            image-size: 66 66

            UIItem
              item-id: 7635
              anchors.centerIn: parent
