        anchors.top: parent.top
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        margin-top: 20
        margin-left: 4
        margin-bottom: 4
        width: 155
        image-source: /modules/game_forge/images/scrollarea
        image-size: 155 80
        image-border: 1
        layout:
          type: grid
          cell-size: 34 34
          cell-spacing: 1
          num-columns: 4
        vertical-scrollbar: transferDonorScrollbar

      VerticalScrollBar
        id: transferDonorScrollbar
