MiniWindow < UIMiniWindow
  font: verdana-11px-antialised
  icon-rect: 4 2 13 13
  icon-clip: 0 0 13 13
  color: #9F9F9F
  width: 176
  height: 200
  text-offset: 19 1
  text-align: topLeft
  image-source: /images/ui/miniwindow
  image-border: 4
  image-border-top: 19
  image-border-bottom: 5
  focusable: false
  &minimizedHeight: 19

  $on:
    image-border-bottom: 4

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-right: 3
    margin-left: 3
    margin-top: 3
    size: 258 14
    phantom: true

  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 3
    size: 12 12
    image-source: /images/ui/miniwindow_buttons
    image-clip: 24 0 12 12

    $hover:
      image-clip: 24 12 12 12

    $pressed:
      image-clip: 24 24 12 12

  UIButton
    id: minimizeButton
    anchors.top: closeButton.top
    anchors.right: closeButton.left
    margin-right: 2
    size: 12 12
    image-source: /images/ui/miniwindow_buttons
    image-clip: 0 0 12 12

    $hover:
      image-clip: 0 12 12 12

    $pressed:
      image-clip: 0 24 12 12

    $on:
      image-clip: 12 0 12 12

    $on hover:
      image-clip: 12 12 12 12

    $on pressed:
      image-clip: 12 24 12 12

  UIButton
    id: lockButton
    anchors.top: minimizeButton.top
    anchors.right: minimizeButton.left
    margin-right: 2
    size: 12 12
    image-source: /images/ui/miniwindow_buttons
    image-clip: 60 0 12 12

    $hover:
      image-clip: 60 12 12 12

    $pressed:
      image-clip: 60 24 12 12

    $on:
      image-clip: 48 0 12 12

    $on hover:
      image-clip: 48 12 12 12

    $on pressed:
      image-clip: 48 24 12 12

  VerticalScrollBar
    id: miniwindowScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    margin-top: 15
    margin-right: 4
    margin-bottom: 4
    pixels-scroll: false
    minimum: 11

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 4
    minimum: 24
    margin-left: 2

MiniWindowContents < ScrollablePanel
  id: contentsPanel
  anchors.fill: parent
  anchors.right: miniwindowScrollBar.left
  margin-left: 3
  margin-bottom: 3
  margin-top: 18
  margin-right: 1
  vertical-scrollbar: miniwindowScrollBar

HeadlessMiniWindowTopBorder < UIWidget
  id: topborder
  image-source: /images/ui/top_panel_border
  width: 190
  height: 2
  &headlessborder: true
  draggable: false

HeadlessMiniWindowBottomBorder < UIWidget
  id: bottomborder
  image-source: /images/ui/bottom_panel_border
  width: 190
  height: 2
  &headlessborder: true
  draggable: false


HeadlessMiniWindow < UIMiniWindow
  font: verdana-11px-antialised
  icon-rect: 4 2 13 13
  icon-clip: 0 0 32 32
  color: #8F8F8F
  width: 190
  height: 200
  focusable: false
  &minimizedHeight: 20
  image-source: /images/ui/special_miniwindow
  image-border: 4
  padding: 3
  padding-top: 0
  padding-bottom: 0
  &headlesswindow: true

  $on:
    image-border-bottom: 2
    
  $!on:
    text:
    icon:

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-right: 3
    margin-left: 3
    margin-top: 3
    size: 258 14
    phantom: true

  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    hidden: true

  VerticalScrollBar
    id: miniwindowScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    margin-top: 16
    margin-right: 4
    margin-bottom: 3
    pixels-scroll: true
    visible: false

    $!on:
      width: 0

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 24
    margin-left: 3
    margin-right: 3
    background: #ffffff88
