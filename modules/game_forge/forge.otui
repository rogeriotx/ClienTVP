  Panel
    id: conversionPanel
    anchors.top: tabSep.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: footerSep.top
    margin-top: 4
    visible: false

    Panel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      width: 310
      height: 253
      layout: horizontalBox
      spacing: 8

      Panel
        width: 151
        height: 253

        Panel
          width: 151
          height: 18
          image-source: /modules/game_forge/images/conversion-column-header
          image-size: 151 18

          Label
            anchors.centerIn: parent
            text: Convert Dust
            font: verdana-9px
            color: #c0c0c0

        Panel
          anchors.top: prev.bottom
          anchors.left: parent.left
          width: 151
          height: 235
          image-source: /modules/game_forge/images/conversion-column
