MinimapFlag < UIWidget
  size: 11 11
  clipping: true

MinimapCross < UIWidget
  focusable: false
  phantom: true
  image: /images/game/minimap/cross
  size: 16 16
  clipping: true

MinimapFloorUpButton < Button
  size: 20 20
  margin-right: 4
  margin-bottom: 25
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  icon-source: /images/game/minimap/floor_up
  icon-clip: 0 0 20 20
  $pressed:
    icon-clip: 0 20 20 20

MinimapFloorDownButton < Button
  size: 20 20
  margin-right: 4
  margin-bottom: 4
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  icon-source: /images/game/minimap/floor_down
  icon-clip: 0 0 20 20
  $pressed:
    icon-clip: 0 20 20 20

MinimapZoomInButton < Button
  size: 20 20
  margin-right: 26
  margin-bottom: 4
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  icon-source: /images/game/minimap/zoom_in
  icon-clip: 0 0 20 20
  $pressed:
    icon-clip: 0 20 20 20

MinimapZoomOutButton < Button
  size: 20 20
  margin-right: 26
  margin-bottom: 25
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  icon-source: /images/game/minimap/zoom_out
  icon-clip: 0 0 20 20
  $pressed:
    icon-clip: 0 20 20 20

MinimapResetButton < Button
  !text: tr('Centre')
  text-auto-resize: true
  anchors.left: parent.left
  anchors.top: parent.top
  margin: 4

MinimapToggleFullMapButton < Button
  !text: tr('Toggle full map')
  text-auto-resize: true
  anchors.left: parent.left
  anchors.bottom: parent.bottom
  margin: 4

Minimap < UIMinimap
  draggable: true
  focusable: false
  cross: true
  color: black

  MinimapFloorUpButton
    id: floorUpWidget
    @onClick: self:getParent():floorUp(1)

  MinimapFloorDownButton
    id: floorDownWidget
    @onClick: self:getParent():floorDown(1)

  MinimapZoomInButton
    id: zoomInWidget
    @onClick: self:getParent():zoomIn()

  MinimapZoomOutButton
    id: zoomOutWidget
    @onClick: self:getParent():zoomOut()

  MinimapResetButton
    id: resetWidget
    @onClick: self:getParent():reset()

  Button
    id: toggleFullmap
    size: 20 20
    !tooltip: tr('Toggle full map')
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin: 4
    icon-source: /images/topbuttons/minimap
    icon-clip: 0 0 20 20
    $pressed:
      icon-clip: 0 20 20 20
    @onClick: modules.game_minimap.toggleFullMap()

// Minimap Flag Create Window


MinimapFlagCheckBox < CheckBox
  size: 16 16
  margin-left: 5
  image-source: /images/game/minimap/flagcheckbox
  image-size: 16 16
  image-border: 3
  icon-source: /images/game/minimap/mapflags
  icon-size: 11 11
  icon-offset: 2 2
  anchors.left: prev.right
  anchors.top: prev.top

  $!checked:
    image-clip: 16 0 16 16

  $checked:
    image-clip: 0 0 16 16
    icon-offset: 3 3

MinimapFlagWindow < MainWindow
  !text: tr('Edit Mark')
  size: 286 230

  Label
    !text: tr('Position') .. ':'
    color: #afafaf
    text-auto-resize: true
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 2

  Label
    id: position
    text-auto-resize: true
    anchors.top: prev.top
    anchors.right: parent.right

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 10

  Label
    !text: tr('Enter a short description') .. ':'
    color: #afafaf
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 10

  TextEdit
    id: description
    margin-top: 3
    anchors.left: parent.left
    anchors.top: prev.bottom
    anchors.right: parent.right

  Label
    !text: tr('Select a type') .. ':'
    color: #afafaf
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 10

  MinimapFlagCheckBox
    id: flag0
    icon-source: /images/game/minimap/flag0
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 6
    margin-left: 0   

  MinimapFlagCheckBox
    id: flag1
    icon-source: /images/game/minimap/flag1

  MinimapFlagCheckBox
    id: flag2
    icon-source: /images/game/minimap/flag2

  MinimapFlagCheckBox
    id: flag3
    icon-source: /images/game/minimap/flag3

  MinimapFlagCheckBox
    id: flag4
    icon-source: /images/game/minimap/flag4

  MinimapFlagCheckBox
    id: flag5
    icon-source: /images/game/minimap/flag5

  MinimapFlagCheckBox
    id: flag6
    icon-source: /images/game/minimap/flag6

  MinimapFlagCheckBox
    id: flag7
    icon-source: /images/game/minimap/flag7

  MinimapFlagCheckBox
    id: flag8
    icon-source: /images/game/minimap/flag8

  MinimapFlagCheckBox
    id: flag9
    icon-source: /images/game/minimap/flag9

  MinimapFlagCheckBox
    id: flag10
    icon-source: /images/game/minimap/flag10
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 6
    margin-left: 0  

  MinimapFlagCheckBox
    id: flag11
    icon-source: /images/game/minimap/flag11

  MinimapFlagCheckBox
    id: flag12
    icon-source: /images/game/minimap/flag12

  MinimapFlagCheckBox
    id: flag13
    icon-source: /images/game/minimap/flag13

  MinimapFlagCheckBox
    id: flag14
    icon-source: /images/game/minimap/flag14

  MinimapFlagCheckBox
    id: flag15
    icon-source: /images/game/minimap/flag15

  MinimapFlagCheckBox
    id: flag16
    icon-source: /images/game/minimap/flag16

  MinimapFlagCheckBox
    id: flag17
    icon-source: /images/game/minimap/flag17

  MinimapFlagCheckBox
    id: flag18
    icon-source: /images/game/minimap/flag18

  MinimapFlagCheckBox
    id: flag19
    icon-source: /images/game/minimap/flag19

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 10
    margin-top: 5

  Button
    id: okButton
    !text: tr('Ok')
    width: 45
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-right: 10

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 45
    anchors.right: parent.right
    anchors.bottom: parent.bottom