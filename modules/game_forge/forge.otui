      anchors.right: parent.right
      height: 115
      margin-top: 4
      image-source: /modules/game_forge/images/window-upper
      image-size: 466 115
      image-border: 30

      Label
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        text: Transfer Requirements
