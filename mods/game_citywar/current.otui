CityWarRankRow < Label
  height: 16
  padding-left: 4
  text-align: left
  color: #dfdfdf
  focusable: false

  $alternate:
    background-color: #00000033

Panel
  Panel
    id: noWar
    anchors.fill: parent

    Panel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 20
      image-source: /images/guild_management/peace

    Label
      id: noWarText
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 20
      text-align: center
      text-auto-resize: true
      !text: tr('Your guild is not in a War Private.')

    Button
      id: createButton
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 20
      width: 150
      !text: tr('Create a new war')
      @onClick: modules.game_citywar.openCreateTab()

  Panel
    id: war
    anchors.fill: parent
    visible: false

    CityWarMiniPanel
      id: score
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 162
      !text: tr('Current War')

      Label
        id: team1Name
        anchors.top: parent.top
        anchors.left: parent.left
        width: 190
        margin-top: 4
        text-align: center
        color: #2FA02F

      Label
        id: team1Kills
        anchors.top: team1Name.bottom
        anchors.horizontalCenter: team1Name.horizontalCenter
        margin-top: 6
        font: sans-bold-16px
        color: #2FA02F
        text-auto-resize: true
        text: 0

      Panel
        id: vs
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        image-source: /images/guild_management/vs

      Label
        id: team2Name
        anchors.top: parent.top
        anchors.right: parent.right
        width: 190
        margin-top: 4
        text-align: center
        color: #E72222

      Label
        id: team2Kills
        anchors.top: team2Name.bottom
        anchors.horizontalCenter: team2Name.horizontalCenter
        margin-top: 6
        font: sans-bold-16px
        color: #E72222
        text-auto-resize: true
        text: 0

      Label
        id: team1Players
        anchors.top: team1Kills.bottom
        anchors.horizontalCenter: team1Name.horizontalCenter
        margin-top: 4
        font: verdana-9px
        color: #9f9f9f
        text-auto-resize: true

      Label
        id: team2Players
        anchors.top: team2Kills.bottom
        anchors.horizontalCenter: team2Name.horizontalCenter
        margin-top: 4
        font: verdana-9px
        color: #9f9f9f
        text-auto-resize: true

      Label
        id: timer
        anchors.top: vs.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 10
        color: #dfb382
        text-auto-resize: true

      Label
        id: cityLabel
        anchors.top: timer.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 4
        color: #dfdfdf
        text-auto-resize: true

      Label
        id: rulesText
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        height: 48
        color: #9f9f9f
        text-wrap: true
        text-align: center

    CityWarMiniPanel
      id: ranking
      anchors.top: score.bottom
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-top: 8
      width: 310
      !text: tr('Ranking (kills / deaths)')

      TextList
        id: rankList
        anchors.fill: parent

    Panel
      id: actions
      anchors.top: score.bottom
      anchors.left: ranking.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 8
      margin-left: 10
      layout:
        type: verticalBox
        spacing: 8

      Label
        id: myStats
        height: 42
        color: #dfdfdf
        text-wrap: true
        text-align: topLeft

      Button
        id: joinButton
        height: 22
        color: #2FA02F
        !text: tr('Join the war')
        @onClick: modules.game_citywar.joinWar()

      Button
        id: leaveButton
        height: 22
        !text: tr('Leave the war')
        @onClick: modules.game_citywar.leaveWar()

      Button
        id: rankButton
        height: 22
        !text: tr('Refresh ranking')
        @onClick: modules.game_citywar.requestRanking()

      Button
        id: cancelButton
        height: 22
        color: #FF4040
        !text: tr('Forfeit war')
        @onClick: modules.game_citywar.cancelWar()
