Item < UIItem
  size: 34 34
  padding: 1
  image-source: /images/ui/item
  font: verdana-11px-rounded
  border-color: white
  color: white

  $disabled:
    color: #646464

ItemTooltip < UIItemTooltip
  size: 34 34
  padding: 1
  image-source: /images/ui/item
  image-color: #999999
  font: verdana-11px-rounded
  color: white
  virtual: true