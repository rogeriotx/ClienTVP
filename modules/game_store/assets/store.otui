Teste < UIWidget
  size: 0 80
  image-smooth: true
  image-fixed-ratio: false
  anchors.right: parent.right
  margin-top: 15

  Label
    id: lblName
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-left: 45
    margin-top: -10
    text-wrap: true
    text-auto-resize: true
    text-align: center
    text: Addon ??

  Box
    id: boxOffer
    size: 86 64
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin: 5 0 0 0

    UICreature
      id: outfit
      size: 64 64
      old-scaling: true
      scale: 0.8
      padding: 8 0 0 8
      anchors.centerIn: parent

  StoreButtonWidget
    id: btnBuy
    anchors.top: prev.top
    anchors.left: prev.right
    anchors.right: parent.right
    margin-left: 5
    margin-top: 15
    !text: tr('Buy')
    font: cipsoftFont
    image-color: #75bfff

  StoreFlatPanelWidget
    id: lblPrice
    size: 104 20
    anchors.top: prev.bottom
    anchors.left: prev.left
    anchors.right: prev.right
    margin: 3 1 0 1
    text-align: center
    text-offset: -18 0
    image-color: #1111118c
    text: ?
    icon: tibiaCoin
    icon-align: center
    icon-offset: 10 0

Box < UIWidget
  border-width-top: 1
  border-color-top: black
  border-width-left: 1
  border-color-left: black
  border-width-bottom: 1
  border-color-bottom: gray
  border-width-right: 1
  border-color-right: gray
  image-smooth: true
  image-fixed-ratio: false

HistoryEntry < UIWidget
  anchors.top: parent.top
  anchors.right: parent.right
  margin-right: 8
  margin-top: 24
  size: 535 15
  background-color: #484848

  Label
    id: historyDate
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3

  Label
    id: historyBalance
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 147

  Label
    id: historyDescription
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 242

RowStore < StoreLightFlatPanelWidget
  height: 78
  margin: 2
  border: 0 white

  $focus:
    border: 2 white

  Box
    id: boxOffer
    size: 64 64
    anchors.top: parent.top
    anchors.left: parent.left
    margin: 5 0 0 5

    UIWidget
      id: image
      size: 64 64

    UICreature
      id: outfit
      size: 64 64
      old-scaling: true
      scale: 0.8
      padding: 8 0 0 8
      anchors.centerIn: parent

    UIItem
      id: item
      virtual: true
      &noRarityFrame: true
      size: 64 64
      padding: 8
      anchors.centerIn: parent

  Label
    id: lblName
    anchors.top: parent.top
    anchors.left: prev.right
    anchors.right: parent.right
    margin: 8 0 0 8
    text-vertical-auto-resize: true
    text-wrap: true

  StoreFlatPanelWidget
    id: lblPrice
    size: 104 20
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin: 0 5 5 0
    text-align: center
    text-offset: 15 0
    image-color: #1111118c
    icon: tibiaCoin
    icon-align: right
    icon-offset: -2 0

MenuCategoryStore < UIWidget
  height: 22
  image-source: barra
  image-border: 5
  margin: 3
  image-clip: 0 0 166 22
  text-align: left
  text-offset: 25 0
  text-wrap: true
  icon-align: left
  icon-offset: 6 0

  $pressed:
    text-offset: 25 0

  $focus:
    image-clip: 0 22 166 22

StoreWindowWidget
  size: 780 537
  !text: tr('Ravenor Store')
  color: #909090
  visible: false
  @onEscape: modules.game_store.onCloseStore()

  StoreButtonWidget
    id: btnWithdraw
    width: 52
    anchors.right: next.left
    anchors.bottom: next.bottom
    margin-right: 11
    !text: tr('Withdraw')
    @onClick: modules.game_store.toggleWithdraw()
  
  StoreButtonWidget
    id: btnHistory
    width: 43
    anchors.right: next.left
    anchors.bottom: next.bottom
    margin-right: 11
    !text: tr('History')
    font: cipsoftFont
    @onClick: modules.game_store.toggleTransferHistory()

  StoreButtonWidget
    id: btnClose
    width: 43
    margin-right: -5
    margin-bottom: -3
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    !text: tr('Close')
    @onClick: modules.game_store.onCloseStore()

  StoreFlatPanelWidget
    id: lblCoins
    size: 260 20
    anchors.bottom: btnClose.bottom
    anchors.left: parent.left
    margin-left: -5
    text-align: left
    text-offset: 20 0
    image-color: #1111118c
    text: 0
    icon: tibiaCoin
    icon-align: left
    icon-offset: 5 0

  StoreButtonWidget
    id: btnCoins
    size: 64 20
    anchors.bottom: prev.bottom
    anchors.left: prev.right
    margin-left: 11
    image-color: green
    icon: tibiaCoin
    icon-align: center
    icon-offset: 10 -1
    text-offset: -18 0
    !text: tr('Get')
    font: cipsoftFont
    @onClick: modules.game_store.getCoinsWebsite()

    $pressed:
      text-offset: -18 0
      icon-offset: 10 0

  StoreButtonWidget
    id: transferPoints
    tooltip: Transfer Coins
    anchors.bottom: prev.bottom
    anchors.left: prev.right
    margin-left: 11
    icon-align: center
    icon-source: iconTransfer
    size: 64 20
    @onClick: modules.game_store.transferPoints()
  
  HorizontalSeparator
    id: bottomSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: btnClose.top
    margin-bottom: 7
    margin-left: -5
    margin-right: -5

  TextEdit
    id: searchStore
    width: 190
    height: 20
    anchors.left: parent.left
    anchors.bottom: bottomSeparator.top
    margin-bottom: 8
    placeholder: Search...
    @onTextChange: modules.game_store.onSearchChange(self:getText())

  UIScrollArea
    id: listCategory
    size: 190 450
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: searchStore.top
    image-source: panel
    image-border: 3
    auto-focus: none
    layout: verticalBox
    margin-bottom: 5
    padding: 5

  StoreLightFlatPanelWidget
    id: panelItem
    anchors.top: parent.top
    anchors.left: prev.right
    anchors.right: parent.right
    margin-right: -4
    anchors.bottom: bottomSeparator.top
    margin-bottom: 8
    margin-left: 8
    padding: 6

    UIScrollArea
      id: listProduct
      size: 260 407
      anchors.top: parent.top  
      anchors.left: parent.left
      anchors.bottom: parent.bottom 
      vertical-scrollbar: scrollList
      image-source: panel
      image-border: 3
      layout: verticalBox
      padding: 5
      auto-focus: none
    
    VerticalScrollBar
      id: scrollList
      anchors.top: listProduct.top
      anchors.bottom: listProduct.bottom
      anchors.left: listProduct.right
      step: 14
      pixels-scroll: true

    Label
      id: lblName
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-left: 140
      text-wrap: true
      text-vertical-auto-resize: true
      width: 200
      text-align: center
      text: Prismatic Unicorn

    Box
      id: boxOffer
      size: 96 96
      anchors.top: prev.bottom
      anchors.left: scrollList.right
      margin: 8 0 0 8

      UIWidget
        id: image
        size: 96 96

      UICreature
        id: outfit
        size: 64 64
        old-scaling: true
        scale: 0.8
        padding: 8 0 0 8
        anchors.centerIn: parent

      UIItem
        id: item
        virtual: true
        &noRarityFrame: true
        phantom: true
        size: 64 64
        padding: 8
        anchors.centerIn: parent

    StoreButtonWidget
      id: btnBuy
      anchors.top: prev.top
      anchors.left: prev.right
      anchors.right: parent.right
      margin-left: 5
      margin-top: 15
      !text: tr('Buy')
      font: cipsoftFont
      image-color: #75bfff

    StoreFlatPanelWidget
      id: lblPrice
      size: 104 20
      anchors.top: prev.bottom
      anchors.left: prev.left
      anchors.right: prev.right
      margin: 3 1 0 1
      text-align: center
      text-offset: -18 0
      image-color: #1111118c
      text: 8900
      icon: tibiaCoin
      icon-align: center
      icon-offset: 10 0

    StoreFlatLabelWidget
      id: lblDescription
      anchors.top: boxOffer.bottom
      anchors.left: scrollList.right
      anchors.right: parent.right
      anchors.bottom: scrollList.bottom
      margin-left: 8
      margin-top: 7
      text-auto-resize: true
      text-wrap: true

  UIWidget
    id: transferHistory
    image-source: history_container
    image-border: 100
    anchors.top: prev.top
    anchors.bottom: prev.bottom
    anchors.left: prev.left