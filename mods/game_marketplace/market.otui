NavButton < Button
  height: 38
  anchors.left: parent.left
  anchors.right: parent.right
  margin-left: 8
  margin-right: 8
  font: verdana-11px-antialised
  text-align: center
  background-color: #0d0d0d
  border-width: 1
  border-color: #2a2a2a

  $hover:
    background-color: #1a1508
    border-color: #c9a633

  $pressed:
    background-color: #2a2010
    border-color: #c9a633

  $on:
    background-color: #1a1508
    border-color: #c9a633
    color: #c9a633

MarketTab < UIButton
  height: 32
  anchors.top: parent.top
  anchors.left: parent.left
  text-align: center
  font: verdana-11px-antialised
  color: #c9a633
  background-color: #0d0d0d
  border-width: 1
  border-color: #2a2a2a

  $hover:
    background-color: #1a1508
    border-color: #c9a633

  $pressed:
    background-color: #2a2010

MainWindow
  id: market
  size: 1200 580
  @onEscape: modules.game_marketplace.hide()
  anchors.centerIn: parent
  !text: tr("MARKET RARITY ITEMS")

  Button
    id: closeButton
    text: Close
    size: 70 24
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: -1
    margin-right: 55
    color: red
    @onClick: modules.game_marketplace.hide()

  UIWidget
    id: contentArea
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    anchors.right: cats.left
    margin-right: 0

  UIWidget
    id: buyPanel
    anchors.fill: contentArea
    visible: false

    MarketTab
      id: item
      width: 45
      anchors.top: parent.top
      anchors.left: parent.left
        !text: tr("Item")

    MarketTab
      id: name
      width: 150
      anchors.top: item.top
      anchors.left: item.right
      !text: tr("Name")

    MarketTab
      id: rarity
      width: 80
      anchors.top: item.top
      anchors.left: name.right
      !text: tr("Rarity")

    MarketTab
      id: seller
      width: 200
      anchors.top: item.top
      anchors.left: rarity.right
      !text: tr("Seller")

    MarketTab
      id: amount
      width: 55
      anchors.top: item.top
      anchors.left: seller.right
      !text: tr("Amt")

    MarketTab
      id: auction
      width: 80
      anchors.top: item.top
      anchors.left: amount.right
      !text: tr("Bid")

    MarketTab
      id: price
      width: 110
      anchors.top: item.top
      anchors.left: auction.right
      !text: tr("Price")

    MarketTab
      id: timer
      width: 90
      anchors.top: item.top
      anchors.left: price.right
      !text: tr("Timer")

    UIScrollArea
      id: items
      layout: verticalBox
      anchors.top: item.bottom
      anchors.bottom: pageWidget.top
      anchors.left: item.left
      anchors.right: timer.right
      vertical-scrollbar: buyScrollbar
      background-color: #05050588

    VerticalScrollBar
      id: buyScrollbar
      anchors.top: timer.top
      anchors.right: parent.right
      anchors.bottom: items.bottom
      step: 32
      pixels-scroll: true

    PageWidget

    Button
      id: buyButton
      size: 70 24
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-bottom: -1
      margin-right: 35
      text: Buy Now
      @onClick: modules.game_marketplace.buyItem()

    Button
      id: bidButton
      size: 70 24
      anchors.bottom: parent.bottom
      anchors.right: buyButton.left
      margin-right: 5
      margin-bottom: -1
      text: Place Bid
      @onClick: modules.game_marketplace.bidItem()

    Button
      id: refreshButton
      size: 70 24
      anchors.bottom: parent.bottom
      anchors.right: bidButton.left
      margin-right: 5
      margin-bottom: -1
      text: Refresh
      @onClick: modules.game_marketplace.getBuyItems()

  UIWidget
    id: sellPanel
    anchors.fill: contentArea
    margin-bottom: 25
    visible: false

    MarketTab
      id: item
      width: 45
      padding: 2 4
      anchors.left: parent.left
      anchors.top: parent.top
      !text: tr("Item")

    MarketTab
      id: name
      width: 150
      anchors.top: item.top
      anchors.left: item.right
      !text: tr("Name")

    MarketTab
      id: rarity
      width: 80
      anchors.top: item.top
      anchors.left: name.right
      !text: tr("Rarity")

    MarketTab
      id: amount
      width: 70
      anchors.top: item.top
      anchors.left: rarity.right
      !text: tr("Amount")

    MarketTab
      id: auction
      width: 100
      anchors.top: item.top
      anchors.left: amount.right
      !text: tr("Auction")

    MarketTab
      id: price
      width: 150
      anchors.top: item.top
      anchors.left: auction.right
      !text: tr("Price")

    MarketTab
      id: timer
      width: 100
      anchors.top: item.top
      anchors.left: price.right
      !text: tr("Time")

    MarketTab
      id: cancel
      width: 50
      anchors.top: item.top
      anchors.left: timer.right
      !text: tr("-")

    UIScrollArea
      id: items
      layout: verticalBox
      background-color: #05050588
      anchors.top: item.bottom
      anchors.bottom: parent.bottom
      anchors.left: item.left
      anchors.right: cancel.right
      vertical-scrollbar: sellScrollbar

    VerticalScrollBar
      id: sellScrollbar
      anchors.top: timer.top
      anchors.right: parent.right
      anchors.bottom: items.bottom
      step: 15
      pixels-scroll: true

  UIWidget
    id: buyOffersPanel
    anchors.fill: contentArea
    visible: false

    MarketTab
      id: item
      width: 45
      anchors.top: parent.top
      anchors.left: parent.left
      !text: tr("Item")

    MarketTab
      id: name
      width: 150
      anchors.top: item.top
      anchors.left: item.right
      !text: tr("Name")

    MarketTab
      id: rarity
      width: 80
      anchors.top: item.top
      anchors.left: name.right
      !text: tr("Rarity")

    MarketTab
      id: buyer
      width: 100
      anchors.top: item.top
      anchors.left: rarity.right
      !text: tr("Buyer")

    MarketTab
      id: filters
      width: 80
      anchors.top: item.top
      anchors.left: buyer.right
      !text: tr("Filters")

    MarketTab
      id: amount
      width: 70
      anchors.top: item.top
      anchors.left: filters.right
      !text: tr("Amount")

    MarketTab
      id: price
      width: 150
      anchors.top: item.top
      anchors.left: amount.right
      !text: tr("Price")

    MarketTab
      id: timer
      width: 100
      anchors.top: item.top
      anchors.left: price.right
      !text: tr("Timer")

    UIScrollArea
      id: items
      layout: verticalBox
      anchors.top: item.bottom
      anchors.bottom: pageWidget.top
      anchors.left: item.left
      anchors.right: timer.right
      vertical-scrollbar: buyOffersScrollbar
      background-color: #05050588

    VerticalScrollBar
      id: buyOffersScrollbar
      anchors.top: timer.top
      anchors.right: parent.right
      anchors.bottom: items.bottom
      step: 15
      pixels-scroll: true

    PageWidget

    Button
      id: fulfillButton
      size: 70 24
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      text: Fulfill
      margin-bottom: -1
      margin-right: 35
      @onClick: modules.game_marketplace.fulfillBuyOffer()

    Button
      id: refreshButton
      size: 70 24
      margin-bottom: -1
      anchors.bottom: parent.bottom
      anchors.right: fulfillButton.left
      margin-right: 5
      text: Refresh
      @onClick: modules.game_marketplace.getBuyOfferItems()

    Button
      id: createBuyOfferButton
      size: 100 24
      margin-bottom: -1
      anchors.bottom: parent.bottom
      anchors.right: refreshButton.left
      margin-right: 5
      text: + New Offer
      color: #66dd66
      @onClick: modules.game_marketplace.createBuyOffer()

  UIWidget
    id: myBuyOffersPanel
    anchors.fill: contentArea
    visible: false

    MarketTab
      id: item
      width: 45
      padding: 2 4
      anchors.left: parent.left
      anchors.top: parent.top
      !text: tr("Item")

    MarketTab
      id: name
      width: 150
      anchors.top: item.top
      anchors.left: item.right
      !text: tr("Name")

    MarketTab
      id: rarity
      width: 80
      anchors.top: item.top
      anchors.left: name.right
      !text: tr("Rarity")

    MarketTab
      id: filters
      width: 80
      anchors.top: item.top
      anchors.left: rarity.right
      !text: tr("Filters")

    MarketTab
      id: amount
      width: 70
      anchors.top: item.top
      anchors.left: filters.right
      !text: tr("Amount")

    MarketTab
      id: price
      width: 150
      anchors.top: item.top
      anchors.left: amount.right
      !text: tr("Price")

    MarketTab
      id: timer
      width: 100
      anchors.top: item.top
      anchors.left: price.right
      !text: tr("Time")

    MarketTab
      id: cancel
      width: 50
      anchors.top: item.top
      anchors.left: timer.right
      !text: tr("-")

    UIScrollArea
      id: items
      layout: verticalBox
      background-color: #05050588
      anchors.top: item.bottom
      anchors.bottom: createBuyOfferButton.top
      anchors.left: item.left
      anchors.right: cancel.right
      margin-bottom:3
      vertical-scrollbar: myBuyOffersScrollbar

    VerticalScrollBar
      id: myBuyOffersScrollbar
      anchors.top: timer.top
      anchors.right: parent.right
      anchors.bottom: items.bottom
      margin.bottom: 1
      step: 15
      pixels-scroll: true

    Button
      id: createBuyOfferButton
      size: 100 24
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-bottom: -1
      margin-right: 35
      text: + New Offer
      color: #66dd66
      @onClick: modules.game_marketplace.createBuyOffer()

  UIWidget
    id: historicPanel
    anchors.fill: contentArea
    margin-bottom: 25
    visible: false

    UIScrollArea
      id: list
      anchors.fill: parent
      margin-left: 8
      background-color: #05050588
      layout: verticalBox
      vertical-scrollbar: historicScrollbar

    VerticalScrollBar
      id: historicScrollbar
      anchors.top: list.top
      anchors.bottom: list.bottom
      anchors.right: parent.right
      step: 28
      pixels-scroll: true

  UIWidget
    id: cats
    background-color: #0a0a0acc
    border-width: 1
    border-color: #2a2a2a
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 185
    margin-bottom: 25

    Label
      id: filterTitle
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      text: Filters
      text-align: center
      color: #c9a633
      font: verdana-11px-antialised
      margin-top: 10

    ComboBox
      id: comboBox
      anchors.top: filterTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      margin-left: 8
      margin-right: 8

    TextEdit
      id: searchEdit
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      margin-left: 8
      margin-right: 8
      placeholder: Search items...

    HorizontalSeparator
      height: 2
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 12
      margin-left: 8
      margin-right: 8
      background-color: #2a2a2a

    Label
      id: navTitle
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      text: Navigation
      text-align: center
      color: #c9a633
      font: verdana-11px-antialised
      margin-top: 12

    NavButton
      id: buyTabButton
      anchors.top: navTitle.bottom
      margin-top: 10
      text: Browse Offers
      !tooltip: tr("Browse items for sale")
      @onClick: modules.game_marketplace.showBuyPanel()

    NavButton
      id: sellTabButton
      anchors.top: prev.bottom
      margin-top: 4
      text: My Listings
      !tooltip: tr('Ctrl+Right click an item and select "Add Market ..." to sell an item.')
      @onClick: modules.game_marketplace.showSellPanel()

    NavButton
      id: buyOffersTabButton
      anchors.top: prev.bottom
      margin-top: 4
      text: Buy Requests
      !tooltip: tr("Browse buy offers from other players")
      @onClick: modules.game_marketplace.showBuyOffersPanel()

    NavButton
      id: myBuyOffersTabButton
      anchors.top: prev.bottom
      margin-top: 4
      text: My Requests
      !tooltip: tr("Create and manage your buy offers")
      @onClick: modules.game_marketplace.showMyBuyOffersPanel()

    NavButton
      id: historicTabButton
      anchors.top: prev.bottom
      margin-top: 4
      text: Transaction History
      !tooltip: tr("Show your History")
      @onClick: modules.game_marketplace.showHistoricPanel()

createConfirmSellWindow < MainWindow
  size: 320 340
  text: List Item for Sale

  Item
    id: item
    size: 40 40
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 5

  Label
    id: name
    anchors.top: prev.bottom
    anchors.right: parent.right
    anchors.left: parent.left
    text-align: center
    margin-top: 8
    color: #c9a633

  Label
    id: currencyLabel
    text: Currency:
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 12

  ComboBox
    id: currency
    anchors.top: name.bottom
    anchors.left: prev.right
    anchors.right: parent.right
    margin-left: 8
    margin-top: 8

  UIWidget
    id: pricelabel
    anchors.top: currencyLabel.bottom
    anchors.left: parent.left
    !text: tr("Price per unit:")
    margin-top: 18

  TextEdit
    id: priceedit
    anchors.top: currency.bottom
    anchors.left: pricelabel.right
    anchors.right: parent.right
    margin-top: 8
    margin-left: 8
    @onTextChange: modules.game_marketplace.onSellPriceChange()
    @onSetup: self:setValidCharacters('0123456789')

  Label
    id: totalCost
    size: 140 22
    anchors.top: pricelabel.bottom
    anchors.left: parent.left
    background-color: #0a0a0a
    border-width: 1
    border-color: #2a2a2a
    margin-top: 12
    text-align: center
    text: Total: 0

  Label
    id: fee
    height: 22
    anchors.top: pricelabel.bottom
    anchors.left: totalCost.right
    anchors.right: parent.right
    background-color: #0a0a0a
    border-width: 1
    border-color: #2a2a2a
    text-align: center
    text: Fee: 0
    margin-top: 12
    margin-left: 6

  CheckBox
    id: bidCheckBox
    size: 100 22
    anchors.top: totalCost.bottom
    anchors.left: parent.left
    margin-top: 15
    text-offset: 18 -7
    !text: tr("Bid minimum:")
    @onCheckChange: modules.game_marketplace.onSellBidCheckChange()

  TextEdit
    id: bidEdit
    height: 22
    anchors.top: totalCost.bottom
    anchors.left: bidCheckBox.right
    anchors.right: parent.right
    margin-top: 12
    @onSetup: self:setValidCharacters('0123456789')
    enabled: false

  HorizontalScrollBar
    id: amount
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12

  Label
    id: limitTime
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 15
    text: Duration:

  ComboBox
    id: timebox
    anchors.top: amount.bottom
    anchors.left: prev.right
    anchors.right: parent.right
    margin-left: 8
    margin-top: 12

  HorizontalSeparator
    id: spec
    height: 2
    visible: false
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12
    background-color: #2a2a2a

  Button
    id: confirm
    size: 80 24
    anchors.top: spec.bottom
    anchors.right: parent.right
    color: #66dd66
    !text: tr("List Item")
    @onClick: modules.game_marketplace.onConfirmSellItem()

  Button
    id: close
    size: 70 24
    anchors.top: spec.bottom
    anchors.left: parent.left
    !text: tr("Cancel")
    @onClick: self:getParent():hide()

createConfirmBuyOfferWindow < MainWindow
  size: 380 540
  text: Create Buy Request

  Label
    id: searchLabel
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 8
    text: Search Item:
    color: #c9a633

  TextEdit
    id: itemSearch
    anchors.top: parent.top
    anchors.left: searchLabel.right
    anchors.right: parent.right
    margin-left: 8
    margin-top: 5
    placeholder: Type item name...

  UIScrollArea
    id: searchResults
    anchors.top: itemSearch.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 150
    margin-top: 6
    layout: verticalBox
    vertical-scrollbar: searchScrollbar
    background-color: #05050588
    border-width: 1
    border-color: #1a1a1a

  VerticalScrollBar
    id: searchScrollbar
    anchors.top: searchResults.top
    anchors.bottom: searchResults.bottom
    anchors.right: parent.right
    step: 30
    pixels-scroll: true

  Item
    id: item
    size: 40 40
    anchors.top: searchResults.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 8
    virtual: false

  Label
    id: name
    anchors.top: prev.bottom
    anchors.right: parent.right
    anchors.left: parent.left
    text-align: center
    margin-top: 6
    text: Select an item above
    color: #888888

  Label
    id: currencyLabel
    text: Currency:
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 10

  ComboBox
    id: currency
    anchors.top: name.bottom
    anchors.left: prev.right
    anchors.right: parent.right
    margin-left: 8
    margin-top: 6

  UIWidget
    id: pricelabel
    anchors.top: currencyLabel.bottom
    anchors.left: parent.left
    !text: tr("Price per unit:")
    margin-top: 18

  TextEdit
    id: priceedit
    anchors.top: currency.bottom
    anchors.left: pricelabel.right
    anchors.right: parent.right
    margin-top: 8
    margin-left: 8
    @onTextChange: modules.game_marketplace.onBuyOfferPriceChange()
    @onSetup: self:setValidCharacters('0123456789')

  Label
    id: totalCost
    size: 150 22
    anchors.top: pricelabel.bottom
    anchors.left: parent.left
    background-color: #0a0a0a
    border-width: 1
    border-color: #2a2a2a
    margin-top: 8
    text-align: center
    text: Total: 0

  Label
    id: fee
    height: 22
    anchors.top: pricelabel.bottom
    anchors.left: totalCost.right
    anchors.right: parent.right
    background-color: #0a0a0a
    border-width: 1
    border-color: #2a2a2a
    text-align: center
    text: Fee: 0
    margin-top: 8
    margin-left: 6

  HorizontalScrollBar
    id: amount
    anchors.top: fee.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10

  Label
    id: limitTime
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 10
    text: Duration:

  ComboBox
    id: timebox
    anchors.top: amount.bottom
    anchors.left: prev.right
    anchors.right: parent.right
    margin-left: 8
    margin-top: 6

  Label
    id: rarityLabel
    anchors.top: timebox.bottom
    anchors.left: parent.left
    margin-top: 10
    text: Rarity Filter:
    color: #c9a633

  ComboBox
    id: rarityComboBox
    anchors.top: timebox.bottom
    anchors.left: rarityLabel.right
    anchors.right: parent.right
    margin-left: 8
    margin-top: 6

  Label
    id: tierLabel
    anchors.top: rarityComboBox.bottom
    anchors.left: parent.left
    margin-top: 10
    text: Tier Filter:
    color: #c9a633

  ComboBox
    id: tierComboBox
    anchors.top: rarityComboBox.bottom
    anchors.left: tierLabel.right
    anchors.right: parent.right
    margin-left: 8
    margin-top: 6

  HorizontalSeparator
    id: spec
    height: 2
    anchors.top: tierComboBox.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    background-color: #2a2a2a

  Button
    id: confirm
    size: 90 24
    anchors.top: spec.bottom
    anchors.right: parent.right
    margin-top: 7
    color: #66dd66
    !text: tr("Create Offer")
    @onClick: modules.game_marketplace.onConfirmBuyOffer()

  Button
    id: close
    size: 70 24
    anchors.top: spec.bottom
    anchors.left: parent.left
    margin-top: 7
    !text: tr("Cancel")
    @onClick: self:getParent():hide()


