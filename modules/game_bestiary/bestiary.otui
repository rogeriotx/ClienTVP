CharmItem < UICheckBox
  !text: tr('Title')
  image-source: images/ui/minipanel
  image-border: 3
  image-border-top: 22
  color: #929292
  text-offset: 0 3
  text-align: top
  border: 0 #ffffff
  $focus:
    border: 2 #ffffff
  @onClick: |
    local main = self:getParent():getParent():getParent():getParent()
    local selectPoints = tonumber(self:recursiveGetChildById('ValueFix'):getText()) and tonumber(self:recursiveGetChildById('ValueFix'):getText()) or 0
    local goldCoins = tonumber(main:recursiveGetChildById('goldCoinsValue'):getText()) and tonumber(main:recursiveGetChildById('goldCoinsValue'):getText())*g_game:getLocalPlayer():getLevel() or 0
    local charmsPoints = tonumber(main:recursiveGetChildById('charmsPoints'):getText()) and tonumber(main:recursiveGetChildById('charmsPoints'):getText()) or 0
    local extraCharmsPoints = tonumber(main:recursiveGetChildById('extraCharmsPoints'):getText()) and tonumber(main:recursiveGetChildById('extraCharmsPoints'):getText()) or 0
    local canOutfit = self:recursiveGetChildById('outfit'):getOutfit().type ~= 0 and true or false

    self:getParent():focusChild(self, ActiveFocusReason)
    main:recursiveGetChildById('showCreatureID'):setText(self.monster)
    main:recursiveGetChildById('showCreature'):setOutfit(self:recursiveGetChildById('outfit'):getOutfit())
    main:recursiveGetChildById('showCreature'):setAnimate(canOutfit)
    main:recursiveGetChildById('showCreature'):setEnabled(canOutfit)
    main:recursiveGetChildById('ItemBase'):getChildById('image'):getChildById('imageID'):setText(self:getId())
    main:recursiveGetChildById('ItemBase'):getChildById('image'):setImageSource("images/charms/"..self:getId().."")
    main:recursiveGetChildById('TextBase'):setText(self.desc)
    if not self:recursiveGetChildById('Charm'):isVisible() then
      main:recursiveGetChildById('PriceBaseMain'):getChildById('Value'):setText(modules.game_bestiary.formatMoney(selectPoints*g_game:getLocalPlayer():getLevel()))
    else
      main:recursiveGetChildById('PriceBaseMain'):getChildById('Value'):setText(selectPoints)
    end

    if self:recursiveGetChildById('lockedMask'):isVisible() then
      main:recursiveGetChildById('UnlockButton'):setText("Unlock")
      if charmsPoints+extraCharmsPoints >= selectPoints then
        main:recursiveGetChildById('UnlockButton'):setEnabled(true)
      else
        main:recursiveGetChildById('UnlockButton'):setEnabled(false)
      end
      main:recursiveGetChildById('PriceBaseMain'):getChildById('Gold'):setVisible(false)
      main:recursiveGetChildById('PriceBaseMain'):getChildById('Charm'):setVisible(true)
    else
      if main:recursiveGetChildById('showCreature'):getOutfit().type == 0 then
        main:recursiveGetChildById('UnlockButton'):setText("Select")
        if goldCoins >= selectPoints then
            main:recursiveGetChildById('UnlockButton'):setEnabled(true)
        else
            main:recursiveGetChildById('UnlockButton'):setEnabled(false)
        end
        if not canOutfit then
          main:recursiveGetChildById('UnlockButton'):setEnabled(false)
        end
      else
        main:recursiveGetChildById('UnlockButton'):setText("Remove")
        if goldCoins >= selectPoints then
            main:recursiveGetChildById('UnlockButton'):setEnabled(true)
        else
            main:recursiveGetChildById('UnlockButton'):setEnabled(false)
        end
      end
      main:recursiveGetChildById('PriceBaseMain'):getChildById('Gold'):setVisible(true)
      main:recursiveGetChildById('PriceBaseMain'):getChildById('Charm'):setVisible(false)
    end

    if self:recursiveGetChildById('lockedMask'):isVisible()
    or main:recursiveGetChildById('UnlockButton'):getText() == "Remove" then
      main:recursiveGetChildById('CreatureList'):hide()
    else
      main:recursiveGetChildById('CreatureList'):show()
    end

    modules.game_bestiary.G_BESTIARY.send("coins")

  UIWindow
    id: InfoBase
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 5
    margin-right: 5
    image-source: images/ui/panel_flat
    image-border: 10
    size: 66 66
    phantom: true

    UICreature
      id: outfit
      anchors.centerIn: parent
      size: 64 64
      phantom: true

  UIWidget
    id: PriceBase
    size: 73 20
    anchors.left: parent.left
    anchors.bottom: InfoBase.bottom
    margin-left: 8
    image-source: images/ui/item
    image-border: 10
    phantom: true

    Label
      id: Value
      anchors.centerIn: parent
      !text: tr('0')
      text-auto-resize: true
      margin-right: 3

      UIWidget
        id: ValueFix
        text: 0
        visible: false

    UIWidget
      id: Charm
      anchors.left: Value.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      image-source: images/ui/icon_charms

    UIWidget
      id: Gold
      anchors.left: Value.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      image-source: images/ui/icon_gold
      visible: false

  UIWindow
    id: charmBase
    anchors.bottom: PriceBase.top
    anchors.horizontalCenter: PriceBase.horizontalCenter
