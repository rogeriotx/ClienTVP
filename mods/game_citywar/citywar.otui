CityWarTabBar < UITabBar
  size: 80 28
  Panel
    id: buttonsPanel
    anchors.fill: parent

CityWarTabBarPanel < Panel

CityWarTabBarButton < UIButton
  size: 22 28
  image-source: /images/ui/tabbutton_rounded
  image-color: #dfdfdf
  image-clip: 0 0 22 23
  image-border: 3
  color: #dfdfdf
  anchors.top: parent.top
  padding: 5 14

  $first:
    anchors.left: parent.left

  $!first:
    anchors.left: prev.right
    margin-left: 4

  $hover !checked:
    image-clip: 0 23 22 23
    color: #dfdfdf

  $disabled:
    image-color: #dfdfdf88
    color: #9f9f9f

  $checked:
    image-clip: 0 46 22 23
    color: #dfdfdf

  $on !checked:
    color: #de6f6f

CityWarMiniPanel < Panel
  text-offset: 0 2
  text-align: top
  image-source: /images/ui/miniwindow
  image-border: 4
  image-border-top: 20
  image-border-bottom: 4
  padding-left: 6
  padding-bottom: 6
  padding-top: 22
  padding-right: 6

CityWarFieldLabel < Label
  color: #dfdfdf
  text-align: left
  height: 14

CityWarHint < Label
  color: #9f9f9f
  font: verdana-9px
  text-align: left
  height: 12

MainWindow
  id: cityWarWindow
  size: 620 610
  !text: tr('War Private')
  @onEscape: modules.game_citywar.hide()

  CityWarTabBar
    id: tabBar
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    width: 510

  HorizontalSeparator
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right

  Panel
    id: content
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 10
    margin-bottom: 40

  HorizontalSeparator
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 30

  Label
    id: statusLabel
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: closeButton.left
    margin-right: 10
    margin-bottom: 4
    text-align: left
    color: #9f9f9f

  Button
    id: closeButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 64
    !text: tr('Close')
    @onClick: modules.game_citywar.hide()
