            size: 66 66
            image-source: /modules/game_forge/images/item66
            image-size: 66 66

            UIItem
              item-id: 7634
              anchors.centerIn: parent
              size: 62 62
              virtual: true
              phantom: true

          ForgeInfoBg
            anchors.top: prev.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 2

            Label
              id: dustConvCostLabel
              text: 60
              font: verdana-9px
              color: #d33c3c
              margin-left: 4

            UIWidget
              size: 9 6
              margin-left: 2
              image-source: /modules/game_forge/images/icon-currency-dust
              image-size: 9 6

          UIWidget
            anchors.top: prev.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 8
            size: 25 14
            image-source: /modules/game_forge/images/arrows/icon-arrow-downlarge
            image-size: 25 14

          UIButton
            id: btnConvertDust
