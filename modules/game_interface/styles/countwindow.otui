CountWindow < MainWindow
  id: countWindow
  !text: tr('Move Objects')
  size: 236 136
  color: #8F8F8F

  SpinBox
    id: spinBox
    anchors.left: parent.left
    anchors.top: parent.top
    width: 1
    height: 1
    margin-top: 2
    focusable: true
    visible: false

  UIItem
    id: item
    size: 32 32
    image-color: alpha
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 9
    margin-left: 3
    focusable: false
    virtual: true
    font: verdana-11px-rounded

  Label
    anchors.top: prev.top
    anchors.left: parent.left
    margin-left: 46
    margin-top: -3
    !text: tr('Set the number of')
    color: #bfbfbf
  
  Label
    anchors.top: prev.bottom
    anchors.left: prev.left
    margin-top: 1
    color: #bfbfbf
    !text: tr('items you want to move:')

  HorizontalScrollBar
    id: countScrollBar
    width: 156
    anchors.left: prev.left
    anchors.top: prev.bottom
    margin-top: 6
    focusable: false

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 9
    margin-left: -3
    margin-right: -3

  Button
    id: buttonOk
    !text: tr('Ok')
    width: 43
    anchors.right: next.left
    anchors.bottom: next.bottom
    margin-right: 11

  Button
    id: buttonCancel
    !text: tr('Cancel')
    width: 43
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: -6
    margin-right: -3
