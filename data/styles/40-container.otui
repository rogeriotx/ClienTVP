PageButton < Button
  size: 30 18
  margin: 1


ContainerWindow < MiniWindow
  height: 75
  &save: true
  &containerWindow: true
  &openOnTopPanel: true

  UIItem
    id: containerItemWidget
    virtual: true
    size: 12 12
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 3
    margin-left: 5
    image-color: alpha

  UIButton
    id: upButton
    anchors.top: lockButton.top
    anchors.right: lockButton.left
    margin-right: 2
    size: 12 12
    image-source: /images/ui/miniwindow_buttons
    image-clip: 36 0 12 12

    $hover:
      image-clip: 36 12 12 12

    $pressed:
      image-clip: 36 24 12 12

  Panel
    id: pagePanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: miniwindowTopBar.bottom
    margin: 1 3 0 3
    background: #00000066
    height: 20
    
    $on:
      visible: true

    $!on:
      visible: false

    Label
      id: pageLabel
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      text-auto-resize: true

    PageButton
      id: prevPageButton
      text: <
      anchors.top: parent.top
      anchors.left: parent.left

    PageButton
      id: nextPageButton
      text: >
      anchors.top: parent.top
      anchors.right: parent.right

  MiniWindowContents
    padding: 0 0 1 8
    margin-top: 15
    margin-bottom: 3
  
  MiniBroder
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-bottom: 3
    margin-left: 3
