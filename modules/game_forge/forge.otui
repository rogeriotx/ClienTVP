    Panel
      id: resultPanel
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 8
      width: 310
      height: 50
      visible: false

      Label
        id: resultLabel
        anchors.centerIn: parent
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 4
        font: verdana-11px-rounded
        color: #44ad25
        text-wrap: true
        text-align: center

  Panel
    id: historyPanel
    anchors.top: tabSep.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: footerSep.top
    margin-top: 4
    visible: false

    Panel
      id: historyHeader
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 20
      background-color: #363636
      layout: horizontalBox

      Label
        text: Date
        width: 145
        font: verdana-9px
        color: #c0c0c0
        margin-left: 2

      Label
        text: Action
        width: 85
        font: verdana-9px
        color: #c0c0c0

      Label
        text: Details
        font: verdana-9px
        color: #c0c0c0

    ScrollablePanel
      id: historyList
      anchors.top: historyHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: historyNav.top
      background-color: #404040
      layout: verticalBox
      vertical-scrollbar: historyScrollbar

    VerticalScrollBar
      id: historyScrollbar
      anchors.top: historyList.top
      anchors.bottom: historyList.bottom
      anchors.right: historyList.right
      step: 34
      pixels-scroll: true

    Panel
      id: historyNav
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 22
      layout: horizontalBox
      spacing: 4

      Button
        id: btnHistoryPrev
        text: < Prev
        width: 60
        @onClick: modules.game_forge.historyPrevPage()

      Label
        id: historyPageLabel
        text: 1/1
        font: verdana-9px
        color: #dfdfdf

      Button
        id: btnHistoryNext
        text: Next >
        width: 60
        @onClick: modules.game_forge.historyNextPage()

  HorizontalSeparator
    id: footerSep
    anchors.bottom: footer.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 2

  Panel
    id: footer
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 22
    layout: horizontalBox
    spacing: 2

    Panel
      width: 140
      height: 20
