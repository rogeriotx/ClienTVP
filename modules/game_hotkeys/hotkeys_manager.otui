HotkeyListLabel < UILabel
  font: verdana-11px-monochrome
  padding: 0
  focusable: true
  phantom: false
  height: 12
  width: 184
  margin: 1 0 1 0
  padding-left: 18
  padding-right: 18
  text-offset: 0 -2
  background-color: alpha
  color: #afafaf

  $!focus:
    background-color: alpha

  $focus:
    background-color: #707070

MainWindow
  id: hotkeysWindow
  !text: tr('Hotkey Options')
  size: 330 446
  padding-bottom: 10
  padding-left: 18
  padding-right: 18

  @onEnter: modules.game_hotkeys.ok()
  @onEscape: modules.game_hotkeys.cancel()

  Label
    id: currentHotkeysLabel
    !text: tr('Available hotkeys') .. ':'
    color: #c0bcbc
    anchors.left: parent.left
    margin-left: 1
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 6

  TextList
    id: currentHotkeys
    height: 103
    vertical-scrollbar: currentHotkeysScrollBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin: 3 2 0 2
    focusable: false
    color: #484444
    text-offset: 0 4
    opacity: 1
    image-source: /images/ui/windowsolid
    image-border: 1
    padding: 1 14 1 2

    $disabled:
      color: #27272788
      opacity: 0.5

  VerticalScrollBar
    id: currentHotkeysScrollBar
    anchors.top: prev.top
    anchors.bottom: prev.bottom
    margin: 1
    step: 12
    anchors.right: prev.right
    pixels-scroll: true

  Button
    id: resetButton
    width: 43
    !text: tr('Reset')
    anchors.left: parent.left
    anchors.top: next.top
    @onClick: modules.game_hotkeys.reset()
    margin-left: -5

  Button
    id: addHotkeyButton
    !text: tr('Add')
    width: 43
    anchors.right: next.left
    anchors.top: next.top
    margin-right: 10
    @onClick: modules.game_hotkeys.addHotkey()

  Button
    id: removeHotkeyButton
    !text: tr('Remove')
    width: 43
    anchors.right: parent.right
    anchors.top: currentHotkeys.bottom
    margin-right: -5
    margin-top: 8
    @onClick: modules.game_hotkeys.removeHotkey()

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 8
    margin-left: -5
    margin-right: -5

  Label
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 5
    !text: tr('Extra action:')
    color: #c0bcbc
    margin-left: -1    
  
  ComboBoxRounded
    id: action
    anchors.left: prev.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2
    enabled: false
    margin: 0 -1 0 -1
    @onOptionChange: modules.game_hotkeys.updateHotkeyAction()

  Label
    id: hotKeyTextLabel
    !text: tr('Edit hotkey text') .. ':'
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-left: -1
    margin-top: 6
    color: #c0bcbc

  TextEdit
    id: hotkeyText
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    text-offset: 3 0
    margin-top: 2
    @onTextChange: modules.game_hotkeys.onHotkeyTextChange(self:getText())
    height: 16
    padding: 0 3 0 3

  UIWidget
    id: sendBackground
    text-offset: 0 0
    image-source: /images/ui/button
    image-border: 3
    image-clip: 0 46 22 23
    text-offset: 1 1
    anchors.left: prev.left
    anchors.right: prev.right
    anchors.top: prev.bottom
    height: 22
    margin-top: 10
    padding: 5
    image-smooth: true

    CheckBox
      id: sendAutomatically
      !text: tr('Send automatically')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 1
      @onCheckChange: modules.game_hotkeys.onSendAutomaticallyChange(self:isChecked())


  Item
    id: itemPreview
    anchors.left: parent.left
    anchors.top: sendBackground.bottom
    margin-top: 12
    virtual: true

  Button
    id: selectObjectButton
    !text: tr('Select object')
    width: 110
    enabled: false
    anchors.left: prev.right
    anchors.top: prev.top
    margin-left: 8
    @onClick: modules.game_hotkeys.startChooseItem()

  Button
    id: clearObjectButton
    !text: tr('Clear object')
    enabled: false
    anchors.left: prev.left
    anchors.right: prev.right
    anchors.top: prev.bottom
    margin-top: 2
    @onClick: modules.game_hotkeys.clearObject()

  ButtonBox
    id: useOnSelf
    !text: tr('Use on yourself')
    enabled: false
    anchors.left: selectObjectButton.right
    anchors.right: parent.right
    anchors.top: selectObjectButton.top
    checked: false
    margin-left: 8

  ButtonBox
    id: useOnTarget
    !text: tr('Use on target')
    enabled: false
    anchors.left: prev.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    checked: false
    margin-top: 2

  ButtonBox
    id: useWith
    !text: tr('With crosshair')
    enabled: false
    anchors.left: prev.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    checked: false
    margin-top: 2

  HorizontalSeparator
    id: separator2
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 13
    margin-left: -5
    margin-right: -5

  Button
    id: okButton
    !text: tr('Ok')
    width: 43
    anchors.right: next.left
    anchors.bottom: parent.bottom
    @onClick: modules.game_hotkeys.ok()
    margin-right: 10

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 43
    anchors.right: parent.right
    margin-right: -5
    anchors.bottom: parent.bottom
    @onClick: modules.game_hotkeys.cancel()

HotkeyAssignWindow < MainWindow
  id: assignWindow
  !text: tr('Button Assign')
  size: 430 115
  padding-bottom: 10
  padding-left: 18
  padding-right: 18
  @onEscape: self:destroy()

  Label
    !text: tr('Please, press the key you wish to add onto your hotkeys manager')
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    text-auto-resize: true
    text-align: left
    text-wrap: true

  Label
    id: comboPreview
    !text: tr('Current hotkey to add: %s', 'none')
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top: 10
    text-auto-resize: true

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 13
    margin-left: -5
    margin-right: -5

  Button
    id: addButton
    !text: tr('Add')
    width: 43
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-right: 10
    @onClick: modules.game_hotkeys.hotkeyCaptureOk(self:getParent(), self:getParent():getChildById('comboPreview').keyCombo)

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 43
    anchors.right: parent.right
    margin-right: -5
    anchors.bottom: parent.bottom
    @onClick: self:getParent():destroy()