OptionsBroder < UIWidget
  image-source: /images/ui/options_broder
  image-border: 1
  height: 22
  phantom: true
  focusable: false

ClientInfoWindow < MainWindow
  !text: tr('Info')
  size: 244 221

ClientInfoWindow
  id: infoBox
  @onEscape: toggle()

  Panel
    size: 208 129
    margin-left: 2
    anchors.top: parent.top
    anchors.left: parent.left
    text-offset: 0 0
    image-source: /images/ui/button
    image-border: 3
    image-clip: 0 46 22 23
    text-offset: 1 1
    margin-top: 7
    padding: 2 0 4 6
    image-smooth: true

  HorizontalSeparator
    anchors.bottom: next.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 7
    margin-left: -3
    margin-right: -2

  Button
    !text: tr('Ok')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: -2
    margin-bottom: -6
    width: 43
    @onClick: modules.client_info.hide()

  Label
    id: infoLabel1
    color: #A8A8A8
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: 13

  Label
    id: infoLabel2
    color: #A8A8A8
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top: 1

  Label
    id: infoLabel3
    color: #A8A8A8
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top: 1

  Label
    id: infoLabel4
    color: #A8A8A8
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top: 1

  Label
    id: infoLabel5
    color: #A8A8A8
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top: 2

  HorizontalSeparator
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 7
    margin-left: 11
    margin-right: 11

  Label
    id: infoLabel6
    color: #A8A8A8
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 19
    margin-left: 10

  Button
    id: infoLabel7
    color: white
    anchors.left: prev.right
    anchors.top: prev.top
    margin-left: 15
    margin-top: -3
    width: 86
    @onClick: openWebsite()
