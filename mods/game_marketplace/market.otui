HistoricLabel < UIWidget
  height: 25
  font: verdana-11px-antialised
  text-align: left

BidWindow < MainWindow
  id: bidWindow
  anchors.centerIn: parent
  !text: tr('Make your bid')
  size: 280 125
  visible: false
  @onEscape: show()

  Item
    id: item
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 4
    margin-left: 4
    focusable: false
    virtual: true

    UIWidget
      id: tierIcon
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 1
      margin-right: 1
      size: 12 12
      phantom: true
      visible: false

  TextEdit
    id: edit
    height: 20
    anchors.left: item.right
    anchors.right: parent.right
    anchors.top: prev.top
    margin-left: 10
    margin-top: 7

  UIWidget
    id: price
    height: 20
    anchors.left: edit.left
    anchors.right: edit.right
    anchors.top: edit.bottom
    margin-left: 5
    margin-top: 7
    focusable: false

  Button
    id: buttonOk
    !text: tr('Ok')
    height: 20
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-bottom: 4
    margin-left: 6
    focusable: false

  Button
    id: buttonCancel
    !text: tr('Cancel')
    height: 20
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 4
    margin-right: 6
    focusable: false

BuyNowWindow < MainWindow
  !text: tr('Buy Now')
  size: 280 130
  visible: false
  @onEscape: show()

  Item
    id: item
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 4
    margin-left: 4
    focusable: false
    virtual: true

    UIWidget
      id: tierIcon
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 1
      margin-right: 1
      size: 12 12
      phantom: true
      visible: false

  HorizontalScrollBar
    id: countScrollBar
    anchors.left: item.right
    anchors.right: parent.right
    anchors.top: prev.top
    margin-left: 10
    margin-top: 10
    focusable: false

  UIWidget
    id: price
    height: 20
    anchors.left: countScrollBar.left
    anchors.right: countScrollBar.right
    anchors.top: countScrollBar.bottom
    margin-left: 5
    margin-top: 7
    focusable: false

  Button
    id: buttonOk
    !text: tr('Ok')
    height: 20
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-bottom: 6
    margin-left: 6
    focusable: false

  Button
    id: buttonCancel
    !text: tr('Cancel')
    height: 20
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 6
    margin-right: 6
    focusable: false

FulfillBuyOfferWindow < MainWindow
  !text: tr('Fulfill Buy Offer')
  size: 280 130
  visible: false
  @onEscape: show()

  Item
    id: item
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 4
    margin-left: 4
    focusable: false
    virtual: true
    selectable: true

    UIWidget
      id: tierIcon
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 1
      margin-right: 1
      size: 12 12
      phantom: true
      visible: false

  HorizontalScrollBar
    id: countScrollBar
    anchors.left: item.right
    anchors.right: parent.right
    anchors.top: prev.top
    margin-left: 10
    margin-top: 10
    focusable: false

  UIWidget
    id: price
    height: 20
    anchors.left: countScrollBar.left
    anchors.right: countScrollBar.right
    anchors.top: countScrollBar.bottom
    margin-left: 5
    margin-top: 7
    focusable: false

  Button
    id: buttonOk
    !text: tr('Ok')
    height: 20
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-bottom: 6
    margin-left: 6
    focusable: false

  Button
    id: buttonCancel
    !text: tr('Cancel')
    height: 20
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 6
    margin-right: 6
    focusable: false

ItemSearchResultItem < UIWidget
  height: 30
  background-color: alpha

  UIItem
    id: itemWidget
    size: 30 30
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    virtual: true

  Label
    id: itemName
    anchors.left: itemWidget.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    text-align: left

  $focus:
    border-width: 1
    border-color: #c9a633

  $hover:
    border-width: 1
    border-color: #8b6914

ItemSearchWindow < MainWindow
  id: itemSearchWindow
  !text: tr('Search Item')
  size: 300 350
  visible: false
  @onEscape: modules.game_marketplace.closeItemSearch()

  TextEdit
    id: searchEdit
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    placeholder: Type item name...

  UIScrollArea
    id: itemList
    anchors.top: searchEdit.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonCancel.top
    margin-top: 5
    margin-bottom: 5
    layout: verticalBox
    vertical-scrollbar: scrollbar
    background-color: alpha
    image-border: 2

  VerticalScrollBar
    id: scrollbar
    anchors.top: itemList.top
    anchors.bottom: itemList.bottom
    anchors.right: parent.right
    step: 30
    pixels-scroll: true

  Button
    id: buttonOk
    !text: tr('Select')
    width: 60
    height: 25
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 5
    @onClick: modules.game_marketplace.selectSearchedItem()

  Button
    id: buttonCancel
    !text: tr('Cancel')
    width: 60
    height: 25
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 5
    @onClick: modules.game_marketplace.closeItemSearch()

PageButton < Button
  size: 22 22
  anchors.verticalCenter: parent.verticalCenter
  anchors.left: parent.left
  @onClick: modules.game_marketplace.togglePage(self:getId())
  $!first:
    anchors.left: prev.right
    margin-left: 3

PageWidget < UIWidget
  id: pageWidget
  size: 200 30
  anchors.bottom: parent.bottom
  anchors.left: parent.left
  margin-left: 42
  margin-bottom: -4

  PageButton
    id: first
    text: <<

  PageButton
    id: prev
    text: <

  UIWidget
    id: text
    size: 100 30
    anchors.top: parent.top
    anchors.left: prev.right
    margin-left: 3

  PageButton
    id: next
    text: >

  PageButton
    id: last
    text: >>

UIWidgetToMarketItem < UIItem
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.bottom: parent.bottom
  border-width: 0
  virtual: true
  phantom: true

  UIWidget
    id: tierIcon
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 1
    margin-right: 1
    size: 12 12
    phantom: true
    visible: false

MarketSellItem < UIWidget
  height: 32
  background-color: #0a0a0a88
  border-width: 1
  border-color: #1a1a1a

  $focus:
    border-color: #c9a633
    background-color: #1a150888

  $hover:
    border-color: #6b5a28
    background-color: #12100588

  $checked:
    border-color: #c9a633
    background-color: #1a150888

  $on !checked:
    border-color: #c9a633

  UIWidgetToMarketItem
    id: item
    width: 45
    anchors.left: parent.left
    margin-left: 4
    text-align: center

  UIWidgetToMarketItem
    id: name
    width: 150
    anchors.left: item.right
    text-align: left
    text-offset: 8 0

  UIWidgetToMarketItem
    id: rarity
    width: 80
    anchors.left: name.right
    text-align: center
    text-offset: 3 0
    font: verdana-11px-antialised

  UIWidgetToMarketItem
    id: amount
    width: 70
    anchors.left: rarity.right
    text-align: center

  UIWidgetToMarketItem
    id: auction
    width: 100
    anchors.left: amount.right
    text-align: center

  UIWidget
    id: price
    width: 150
    height: 32
    anchors.left: auction.right
    anchors.top: parent.top
    text-align: center
    text-offset: 35 0
    phantom: true

    UIItem
      id: currencyIcon
      size: 32 32
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5
      virtual: true
      phantom: true

  UIWidgetToMarketItem
    id: timer
    width: 100
    anchors.left: price.right
    text-align: center
    text-offset: 3 0

  UIWidgetToMarketItem
    id: cancel
    width: 40
    anchors.left: timer.right

    Button
      id: button
      size: 26 26
      anchors.top: parent.top
      anchors.left: parent.left
      margin: 3
      text: x
      color: #ff4444
      @onClick: modules.game_marketplace.cancelSellItem(self:getParent():getParent())

