FloorTile < UIWidget
  image-source: /images/game/floor
  size: 32 32
  phantom: true

OutfitColorBox < UICheckBox
  image-color: #dfdfdfff
  image-source: /images/ui/scrollbar2
  size: 12 12

  $!checked:
    image-clip: 32 1 12 12
  
  $checked:
    image-clip: 32 13 12 12

ColorSectionButton < UIButton
  height: 20
  width: 43
  font: cipsoftFont
  color: white
  image-source: /images/ui/button
  image-clip: 0 0 22 23
  image-border: 3
  margin-left: 25
  
  $checked !pressed:
    image-clip: 0 46 22 23
    text-offset: 2 2
  
  $!checked !pressed:
    image-clip: 0 0 22 23
    text-offset: 0 0
  
  $pressed:
    image-clip: 0 46 22 23
    text-offset: 2 2

MainWindow
  size: 420 285
  text: Select Outfit
  @onEnter: modules.game_outfit.accept()
  @onEscape: modules.game_outfit.destroy()
  padding: 32 18 10 18

  Creature
    id: creature
    size: 128 128
    padding: 5
    anchors.top: parent.top
    anchors.bottom: colorBoxPanel.bottom
    anchors.left: parent.left
    outfit-shader: outfit_default
  
  FlatLabel
    id: name
    height: 40
    anchors.left: prev.left
    anchors.right: prev.right
    anchors.top: prev.bottom
    margin-top: 5
    text-align: center
    text-wrap: true

  UIButton
    id: prevButton
    anchors.top: name.bottom
    margin-top: 9
    anchors.horizontalCenter: creature.horizontalCenter
    margin-right: 13
    image-color: #ffffffff
    size: 20 20
    @onClick: modules.game_outfit.prevPreview()
    image-source: /images/ui/leftarrow

    $!pressed:
      image-clip: 0 0 20 20

    $pressed:
      image-clip: 20 0 20 20

  UIButton
    id: nextButton
    anchors.top: prevButton.top
    anchors.horizontalCenter: creature.horizontalCenter
    margin-left: 13
    size: 20 20
    @onClick: modules.game_outfit.nextPreview()
    image-source: /images/ui/rightarrow

    $!pressed:
      image-clip: 0 0 20 20

    $pressed:
      image-clip: 20 0 20 20

  ColorSectionButton
    id: head
    text: Head 
    anchors.top: parent.top
    anchors.left: colorBoxPanel.left
    margin-left: 0

  ColorSectionButton
    id: primary
    text: Body 
    anchors.top: prev.top
    anchors.left: prev.right
  
  ColorSectionButton
    id: secondary
    text: Legs
    anchors.top: prev.top
    anchors.left: prev.right
  
  ColorSectionButton
    id: detail
    text: Feet 
    anchors.top: prev.top
    anchors.left: prev.right
  
  Panel
    id: colorBoxPanel
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 138
    margin-top: 25
    size: 246 90
    layout:
      type: grid
      cell-size: 12 12
      cell-spacing: 1
      num-columns: 19
      num-lines: 7

  FlatPanel
    id: addon1
    padding: 5
    size: 191 22
    anchors.left: colorBoxPanel.left
    anchors.right: colorBoxPanel.horizontalCenter
    anchors.top: prevButton.top

    CheckBox
      id: check
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      anchors.right: parent.right
      text: Addon 1

  FlatPanel
    id: addon2
    height: 22
    anchors.top: prev.top
    anchors.left: prev.right
    anchors.right: parent.right
    padding: 5
    margin-left: 5

    CheckBox
      id: check
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      anchors.right: parent.right
      text: Addon 2

  Label
    text: Choose an outfit and determine the colours of the various parts of your character's body
    text-wrap: true
    anchors.left: colorBoxPanel.left
    anchors.right: colorBoxPanel.right
    anchors.top: name.top
    anchors.bottom: name.bottom

  HorizontalSeparator
    id: separator
    anchors.bottom: next.top
    margin-bottom: 8
    margin-left: -5
    margin-right: -5
    anchors.left: parent.left
    anchors.right: parent.right

  Button
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    text: Cancel
    width: 43
    margin-right: -5
    @onClick: modules.game_outfit.destroy()
  
  Button
    anchors.bottom: parent.bottom
    anchors.right: prev.left
    text: Ok
    width: 43
    margin-right: 10
    @onClick: modules.game_outfit.accept()