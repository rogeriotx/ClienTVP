        anchors.bottom: transferDonorList.bottom
        anchors.right: transferDonorList.right
        step: 35
        pixels-scroll: true

      Panel
        id: transferArrowsPanel
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: transferDonorList.right
        margin-left: 8
        margin-bottom: 14
        height: 25
        width: 58
        layout: horizontalBox
        spacing: 6

        UIWidget
