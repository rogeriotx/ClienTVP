PopupMenuButton < UIButton
  size: 0 16
  text-offset: 2 1
  text-align: left
  font: verdana-11px-rounded
  color: #dfdfdf
  background-color: alpha
  margin-bottom: 3

  $last:
    margin-bottom: 0

  $hover !disabled:
    background-color: #808080
    image-clip: 0 40 20 20

  $disabled:
    color: #555555

PopupMenuShortcutLabel < Label
  font: verdana-11px-rounded
  text-align: right
  anchors.fill: parent
  margin-right: 2
  margin-left: 5
  color: #dfdfdf

PopupMenuSeparator < UIWidget
  margin-left: 0
  margin-right: 0
  margin-bottom: 6
  image-source: /images/ui/separator_horizontal
  image-border-left: 1
  image-border-right: 1
  image-clip: 0 0 32 2
  height: 2
  phantom: true

PopupMenuLabel < Label
  text-offset: 2 0
  height: 18
  color: #aaaaaa

PopupMenu < UIPopupMenu
  size: 0 0
  image-source: /images/ui/menubox
  image-border: 3
  padding: 4
  color: #dfdfdf

PopupScrollMenuButton < UIButton
  height: 18
  size: 0 16
  text-offset: 2 1
  text-align: left
  font: verdana-11px-antialised
  margin-bottom: 3
  color: #aaaaaa
  background-color: alpha

  $hover !disabled:
    color: #ffffff
    background-color: #808080
    image-clip: 0 40 20 20

  $disabled:
    color: #555555

PopupScrollMenuShortcutLabel < Label
  font: verdana-11px-rounded
  text-align: right
  anchors.fill: parent
  margin-right: 2
  margin-left: 5

PopupScrollMenuSeparator < UIWidget
  margin: 1 2
  margin-bottom: 6
  image-source: /images/ui/menubox
  image-border-left: 1
  image-border-right: 1
  image-clip: 0 0 32 2
  height: 2
  phantom: true

PopupScrollMenu < UIPopupScrollMenu
  width: 50
  image-source: /images/ui/menubox
  image-border: 3
  padding: 4
  padding-right: 46
