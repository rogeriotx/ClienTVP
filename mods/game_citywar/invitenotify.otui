// Botao flutuante "War Invite" no canto inferior direito do mapa.
// Aparece para os lideres quando a guild recebe convite de War Private.
// Ao clicar abre o modulo na aba Invites.
Button
  id: cityWarInviteNotify
  size: 200 46
  anchors.bottom: parent.bottom
  anchors.right: parent.right
  margin-bottom: 12
  margin-right: 12
  image-color: #ffe0a0
  visible: false
  focusable: false
  !tooltip: tr('Your guild received a War Private invite.\nClick to see the rules and accept or decline it.')
  @onClick: modules.game_citywar.openInvites()

  $hover:
    image-color: #ffffff

  UIWidget
    id: icon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 32 32
    image-source: /images/guild_management/war
    image-smooth: true
    phantom: true

  Label
    id: title
    anchors.top: parent.top
    anchors.left: icon.right
    anchors.right: parent.right
    margin-left: 6
    font: verdana-11px-rounded
    color: #FFD060
    text-align: left
    phantom: true
    !text: tr('WAR INVITE')

  Label
    id: info
    anchors.top: title.bottom
    anchors.left: icon.right
    anchors.right: parent.right
    margin-left: 6
    margin-top: 2
    font: verdana-9px
    color: #dfdfdf
    text-align: left
    phantom: true
